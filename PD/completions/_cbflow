#compdef cbflow
# ══════════════════════════════════════════════════════════════════════════════
# CBFlow v2.0.0 - Zsh Shell Completions
# Source: Add to fpath or copy to /usr/local/share/zsh/site-functions/_cbflow
# ══════════════════════════════════════════════════════════════════════════════

_cbflow_projects() {
    local projects_file="${CBFLOW_CORE_DIR:-}/config/master_projects.json"
    if [[ -f "$projects_file" ]]; then
        local -a projects
        projects=(${(f)"$(python3 -c "import json; f=open('$projects_file'); d=json.load(f); print('\n'.join(d.get('projects',{}).keys()))" 2>/dev/null)"})
        compadd -a projects
    fi
}

_cbflow_flow_types() {
    local -a flows
    flows=(SYNTH FP PNR STA LEC EMIR PV ECO CLP POPT FCFP SYNTH_PNR)
    compadd -a flows
}

_cbflow_releases() {
    local releases_dir="${CBFLOW_CORE_DIR:-}/releases"
    if [[ -d "$releases_dir" ]]; then
        local -a releases
        releases=(${(f)"$(ls -d "$releases_dir"/v* 2>/dev/null | xargs -I{} basename {})"})
        compadd -a releases
    fi
}

_cbflow_milestones() {
    local -a milestones
    milestones=(FP_EXIT PLACE_EXIT CTS_EXIT PRO_EXIT BTO MTO)
    compadd -a milestones
}

_cbflow_tracks() {
    local -a tracks
    tracks=(9T 7.5T 6.75T)
    compadd -a tracks
}

_cbflow() {
    local -a commands

    if (( CURRENT == 2 )); then
        commands=(
            'workspace:Workspace management'
            'run:Flow execution'
            'flow:Flow info and management'
            '--version:Show version'
            '--help:Show help'
        )
        _describe 'command' commands
        return
    fi

    case "${words[2]}" in
        workspace)
            if (( CURRENT == 3 )); then
                local -a ws_cmds
                ws_cmds=(
                    'init:Initialize workspace'
                    'template:Generate user_config.tcl template'
                    'create:Create a new run'
                    'status:Show workspace status'
                    'list-runs:List all runs'
                    'clean:Clean run directories'
                    'validate:Validate workspace config'
                )
                _describe 'workspace command' ws_cmds
            else
                case "${words[3]}" in
                    init)
                        case "${words[CURRENT-1]}" in
                            --project) _cbflow_projects ;;
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--project --flow --release --force)' ;;
                        esac
                        ;;
                    template)
                        case "${words[CURRENT-1]}" in
                            --flow|-t) _cbflow_flow_types ;;
                            --output|-o) _files -g '*.tcl' ;;
                            *) _describe 'option' '(--flow --output)' ;;
                        esac
                        ;;
                    create)
                        case "${words[CURRENT-1]}" in
                            --config|-c) _files -g '*.tcl' ;;
                            *) _describe 'option' '(--config --force)' ;;
                        esac
                        ;;
                esac
            fi
            ;;
        run)
            if (( CURRENT == 3 )); then
                local -a run_cmds
                run_cmds=(
                    'all:Run complete flow'
                    'stage:Run specific stage'
                    'status:Show run status'
                    'retrace:Force rerun'
                    'clean:Clean run directory'
                    'validate:Validate run'
                    'logs:View run logs'
                    'lsf-status:Show LSF job status'
                    'lsf-submit:Submit via LSF'
                    'lsf-run:Direct LSF run'
                    'lsf-queues:Show queue config'
                    'lsf-cost:Show cost info'
                    'email:Send email notifications'
                    'autoppt:Generate run summary PPT/HTML'
                    'checklist:Run exit milestone checklist'
                    'help:Show help'
                )
                _describe 'run command' run_cmds
            else
                case "${words[3]}" in
                    lsf-submit)
                        case "${words[CURRENT-1]}" in
                            --queue|-q) _describe 'queue' '(XS S M L XL ultra)' ;;
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--cmd --flow --stage --queue --memory --cpu --time --name --log-dir --dry-run)' ;;
                        esac
                        ;;
                    lsf-run)
                        case "${words[CURRENT-1]}" in
                            --queue|-q) _describe 'queue' '(XS S M L XL ultra)' ;;
                            *) _describe 'option' '(--cmd --queue --memory --cpu --time --name --log-dir --dry-run)' ;;
                        esac
                        ;;
                    lsf-queues)
                        case "${words[CURRENT-1]}" in
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--flow)' ;;
                        esac
                        ;;
                    validate)
                        case "${words[CURRENT-1]}" in
                            --type) _describe 'type' '(all config inputs exit)' ;;
                            *) _describe 'option' '(--type --stage)' ;;
                        esac
                        ;;
                    all) _describe 'option' '(--validate --lsf --queue --collect-metrics)' ;;
                    logs) _describe 'option' '(--list --tail --search --level --file)' ;;
                esac
            fi
            ;;
        flow)
            if (( CURRENT == 3 )); then
                local -a flow_cmds
                flow_cmds=(
                    'types:List flow types'
                    'info:Show flow info'
                    'stages:Show flow stages'
                    'nodes:Show flow nodes'
                    'check:Check installation'
                    'project:Project management'
                    'version:Version control'
                    'release:Release management'
                    'config:Configuration management'
                    'plugin:Plugin management'
                    'metrics:Metrics and analytics'
                    'dashboard:Web dashboard'
                    'checklist:Exit milestone checklists'
                    'qor-report:QoR report generation'
                    'trending:Historical trending'
                    'library-manager:Library management'
                    'mmmc-manager:MMMC configuration'
                )
                _describe 'flow command' flow_cmds
            elif (( CURRENT == 4 )); then
                case "${words[3]}" in
                    info|stages|nodes)
                        case "${words[CURRENT-1]}" in
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--flow)' ;;
                        esac
                        ;;
                    project)   _describe 'action' '(list info create delete)' ;;
                    version)   _describe 'action' '(list copy create set-current get-current diff status)' ;;
                    release)   _describe 'action' '(generate-config create list info set-current validate components diff help)' ;;
                    config)    _describe 'action' '(manage-flow manage-node manage-tech validate status)' ;;
                    plugin)    _describe 'action' '(register unregister scaffold list)' ;;
                    metrics)   _describe 'action' '(collect report export)' ;;
                    dashboard) _describe 'action' '(start stop)' ;;
                    checklist) _describe 'action' '(generate status sign-off list waiver)' ;;
                    qor-report) _describe 'action' '(generate compare summary)' ;;
                    trending)  _describe 'action' '(report baseline check record stats)' ;;
                    library-manager) _describe 'action' '(scan create check list verify generate-mmmc)' ;;
                    mmmc-manager) _describe 'action' '(create show validate generate-view-def add-mode remove-mode)' ;;
                esac
            else
                # Level 5+: options for specific subcommands
                case "${words[3]}" in
                    checklist)
                        case "${words[CURRENT-1]}" in
                            --milestone) _cbflow_milestones ;;
                            --format) _describe 'format' '(text json html)' ;;
                            --action) _describe 'action' '(list add revoke)' ;;
                            *) _describe 'option' '(--milestone --run-dir --project --phase --format --approver --action --check --reason --expiry)' ;;
                        esac
                        ;;
                    qor-report)
                        case "${words[CURRENT-1]}" in
                            --format) _describe 'format' '(text json csv html)' ;;
                            --milestone) _cbflow_milestones ;;
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--run-dir --milestone --format -o --run-dir1 --run-dir2 --project --flow)' ;;
                        esac
                        ;;
                    trending)
                        if (( CURRENT == 5 )) && [[ "${words[4]}" == "baseline" ]]; then
                            _describe 'action' '(set show)'
                        else
                            case "${words[CURRENT-1]}" in
                                --metric) _describe 'metric' '(wns tns power utilization drc)' ;;
                                --project) _cbflow_projects ;;
                                --flow) _cbflow_flow_types ;;
                                *) _describe 'option' '(--project --flow --metric --last --run-dir --milestone)' ;;
                            esac
                        fi
                        ;;
                    library-manager)
                        case "${words[CURRENT-1]}" in
                            --format) _describe 'format' '(text json)' ;;
                            --path) _path_files -/ ;;
                            --track) _cbflow_tracks ;;
                            --output) _path_files ;;
                            --tech-config) _path_files -g '*.tcl' ;;
                            *) _describe 'option' '(--path --recursive --format --output --tech-config --tech-node --track --verbose --corner --voltage --temp)' ;;
                        esac
                        ;;
                    mmmc-manager)
                        case "${words[CURRENT-1]}" in
                            --config) _path_files -g '*.tcl' ;;
                            --output) _path_files ;;
                            *) _describe 'option' '(--interactive --config --output --corners --voltages --temps --modes --rc-corners --name --desc --freq --sdc)' ;;
                        esac
                        ;;
                    version)
                        case "${words[CURRENT-1]}" in
                            --dir|-d) _path_files -/ ;;
                            --version|-v) _cbflow_releases ;;
                            --format) _describe 'format' '(text json markdown)' ;;
                            *) _describe 'option' '(--dir --version --from --to --v1 --v2 --desc)' ;;
                        esac
                        ;;
                    release)
                        case "${words[CURRENT-1]}" in
                            --version|-v) _cbflow_releases ;;
                            --v1|--v2) _cbflow_releases ;;
                            --type|-t) _describe 'type' '(patch minor major)' ;;
                            --format) _describe 'format' '(text json markdown)' ;;
                            *) _describe 'option' '(--config --type --version --desc --force --v1 --v2 --format)' ;;
                        esac
                        ;;
                    metrics)
                        case "${words[CURRENT-1]}" in
                            --format) _describe 'format' '(json csv)' ;;
                            --flow) _cbflow_flow_types ;;
                            *) _describe 'option' '(--run-dir --project --flow --format -o)' ;;
                        esac
                        ;;
                esac
            fi
            ;;
    esac
}

_cbflow "$@"
