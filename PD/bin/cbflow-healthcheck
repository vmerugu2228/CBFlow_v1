#!/usr/bin/env python3
"""
CBflow Health Check
Validates that all required modules, scripts, configs, and dependencies are present.
Usage: cbflow-healthcheck [--verbose]
"""

import os
import sys
import importlib
import subprocess
import shutil
from pathlib import Path

# ═══════════════════════════════════════════════════════════════════════════════
# Resolve CBFLOW paths
# ═══════════════════════════════════════════════════════════════════════════════
SCRIPT_DIR = Path(__file__).resolve().parent
CBFLOW_CORE = SCRIPT_DIR.parent                    # PD/
CBFLOW_ROOT = CBFLOW_CORE.parent                   # CBflow_clone/
COMMANDS_DIR = CBFLOW_CORE / "utils" / "commands"

VERBOSE = "--verbose" in sys.argv or "-v" in sys.argv

# ═══════════════════════════════════════════════════════════════════════════════
# Counters
# ═══════════════════════════════════════════════════════════════════════════════
PASS = 0
FAIL = 0
WARN = 0

def ok(msg):
    global PASS
    PASS += 1
    print(f"  \033[32m[OK]\033[0m    {msg}")

def fail(msg):
    global FAIL
    FAIL += 1
    print(f"  \033[31m[FAIL]\033[0m  {msg}")

def warn(msg):
    global WARN
    WARN += 1
    print(f"  \033[33m[WARN]\033[0m  {msg}")

def skip(msg):
    if VERBOSE:
        print(f"  [SKIP]  {msg}")

def section(title):
    print(f"\n{'─' * 60}")
    print(f"  {title}")
    print(f"{'─' * 60}")


# ═══════════════════════════════════════════════════════════════════════════════
# 1. System Prerequisites
# ═══════════════════════════════════════════════════════════════════════════════
def check_system():
    section("1. System Prerequisites")

    # Python
    v = sys.version_info
    if v.major == 3 and v.minor >= 6:
        ok(f"Python {v.major}.{v.minor}.{v.micro}")
    else:
        fail(f"Python {v.major}.{v.minor}.{v.micro} (need 3.6+)")

    # tclsh
    if shutil.which("tclsh"):
        try:
            r = subprocess.run(["tclsh", "<<EOF\nputs $tcl_version\nEOF"],
                               capture_output=True, text=True, timeout=5,
                               shell=True)
            # Fallback: just check binary exists
            ok("tclsh found in PATH")
        except Exception:
            ok("tclsh found in PATH")
    else:
        fail("tclsh not found in PATH")

    # make
    if shutil.which("make"):
        ok("GNU make found in PATH")
    else:
        fail("make not found in PATH")

    # bash
    if shutil.which("bash"):
        ok("bash found in PATH")
    else:
        fail("bash not found in PATH")

    # Optional: bsub (LSF)
    if shutil.which("bsub"):
        ok("bsub (LSF) found in PATH")
    else:
        warn("bsub (LSF) not in PATH — LSF submission will fail (OK for local execution)")

    # Optional: xterm
    if shutil.which("xterm"):
        ok("xterm found in PATH")
    else:
        warn("xterm not in PATH — xterm launch mode unavailable")


# ═══════════════════════════════════════════════════════════════════════════════
# 2. Python Standard Library Imports
# ═══════════════════════════════════════════════════════════════════════════════
def check_stdlib():
    section("2. Python Standard Library & Required Modules")

    # All stdlib modules used across CBflow Python code
    stdlib_modules = [
        "argparse", "ast", "os", "sys", "re", "json", "logging",
        "subprocess", "shutil", "csv", "getpass", "io", "signal",
        "sqlite3", "pathlib", "datetime", "collections", "typing",
        "hashlib", "glob", "difflib", "socket", "threading", "time",
        "webbrowser", "http.server", "urllib.parse", "smtplib",
        "email.mime.text", "email.mime.multipart", "email.mime.base",
        "email.encoders", "logging.handlers",
    ]
    # Python 3.7+ modules (may need pip install on 3.6)
    optional_stdlib = [
        ("dataclasses", "pip install dataclasses (Python 3.6 backport)"),
    ]

    fail_count = 0
    for mod in stdlib_modules:
        try:
            importlib.import_module(mod)
            if VERBOSE:
                ok(f"{mod}")
        except ImportError:
            fail(f"{mod} — missing from Python installation")
            fail_count += 1

    for mod, install_hint in optional_stdlib:
        try:
            importlib.import_module(mod)
            if VERBOSE:
                ok(f"{mod}")
        except ImportError:
            fail(f"{mod} — {install_hint}")
            fail_count += 1

    if not VERBOSE and fail_count == 0:
        ok(f"All {len(stdlib_modules) + len(optional_stdlib)} required Python modules present")


# ═══════════════════════════════════════════════════════════════════════════════
# 3. CBflow CLI Scripts (bin/)
# ═══════════════════════════════════════════════════════════════════════════════
def check_bin_scripts():
    section("3. CLI Scripts (bin/)")

    expected = [
        "cbflow", "cbflow-flow", "cbflow-run", "cbflow-workspace",
        "cbflow-config", "cbflow-project", "cbflow-release", "cbflow-version",
    ]
    for script in expected:
        p = CBFLOW_CORE / "bin" / script
        if p.exists():
            if os.access(p, os.X_OK):
                ok(f"{script}")
            else:
                warn(f"{script} — exists but not executable")
        else:
            fail(f"{script} — not found")


# ═══════════════════════════════════════════════════════════════════════════════
# 4. Python Command Modules (utils/commands/)
# ═══════════════════════════════════════════════════════════════════════════════
def check_python_modules():
    section("4. Python Command Modules (utils/commands/)")

    expected = [
        ("workspace_cmd.py", "Workspace management (create, status, template)"),
        ("run_cmd.py", "Run execution (all, stage, status, retrace)"),
        ("start_run.py", "Run creation logic"),
        ("makefile_generator.py", "Makefile generation for stages"),
        ("tcl_config_parser.py", "TCL config file parser"),
        ("logging_config.py", "Logging configuration"),
        ("flow_cmd.py", "Flow info commands"),
        ("project_cmd.py", "Project management"),
        ("release_cmd.py", "Release management"),
        ("lsf_cmd.py", "LSF job submission"),
        ("lsf_manager_cmd.py", "LSF manager (show, map, validate)"),
        ("mmmc_manager_cmd.py", "MMMC scenario management"),
        ("node_manager.py", "Dynamic node management"),
        ("validation_cmd.py", "Validation framework"),
        ("metrics_cmd.py", "Metrics collection"),
        ("checklist_cmd.py", "Exit milestone checklists"),
        ("qor_report_cmd.py", "QoR reporting"),
        ("trending_cmd.py", "QoR trending"),
        ("config_cmd.py", "Config management"),
        ("version_cmd.py", "Version management"),
        ("plugin_cmd.py", "Plugin system"),
        ("dashboard_cmd.py", "Web dashboard"),
        ("library_manager_cmd.py", "Library management"),
        ("log_viewer.py", "Log viewer utility"),
        ("graph_renderer.py", "Dependency graph renderer"),
        ("__init__.py", "Package init"),
    ]

    found = 0
    for filename, desc in expected:
        p = COMMANDS_DIR / filename
        if p.exists():
            found += 1
            if VERBOSE:
                ok(f"{filename:<30s} {desc}")
        else:
            fail(f"{filename:<30s} {desc}")

    if not VERBOSE:
        ok(f"{found}/{len(expected)} Python command modules present")
        if found < len(expected):
            for filename, desc in expected:
                if not (COMMANDS_DIR / filename).exists():
                    fail(f"  Missing: {filename} — {desc}")

    # Check cross-module imports work — tests ALL command modules
    sys.path.insert(0, str(COMMANDS_DIR))
    critical_imports = [
        ("logging_config", "Logging config"),
        ("tcl_config_parser", "Config parser"),
        ("makefile_generator", "Makefile generator"),
        ("start_run", "Run creator"),
        ("run_cmd", "Run command dispatcher"),
        ("workspace_cmd", "Workspace management"),
        ("race_engine", "RACE DAG engine"),
        ("flow_cmd", "Flow info"),
        ("config_cmd", "Config management"),
        ("version_cmd", "Version management"),
        ("release_cmd", "Release management"),
        ("project_cmd", "Project management"),
        ("plugin_cmd", "Plugin system"),
        ("lsf_cmd", "LSF submission"),
        ("lsf_manager_cmd", "LSF manager"),
        ("library_manager_cmd", "Library manager"),
        ("mmmc_manager_cmd", "MMMC manager"),
        ("node_manager", "Node management"),
        ("validation_cmd", "Validation framework"),
        ("metrics_cmd", "Metrics collection"),
        ("checklist_cmd", "Exit checklist"),
        ("qor_report_cmd", "QoR reporting"),
        ("trending_cmd", "QoR trending"),
        ("dashboard_cmd", "Web dashboard"),
        ("log_viewer", "Log viewer"),
        ("graph_renderer", "Graph renderer"),
        ("autoppt_cmd", "AutoPPT generator"),
    ]
    import_pass = 0
    import_fail = 0
    for mod, desc in critical_imports:
        try:
            importlib.import_module(mod)
            import_pass += 1
            if VERBOSE:
                ok(f"import {mod} — {desc}")
        except Exception as e:
            import_fail += 1
            fail(f"import {mod} — {e}")

    if not VERBOSE and import_fail == 0:
        ok(f"All {import_pass} command modules import successfully")
    elif not VERBOSE:
        ok(f"{import_pass}/{len(critical_imports)} command modules OK")


# ═══════════════════════════════════════════════════════════════════════════════
# 5. TCL Utilities
# ═══════════════════════════════════════════════════════════════════════════════
def check_tcl_utilities():
    section("5. TCL Utilities (utils/utilities/v1.0.0/)")

    tcl_dir = CBFLOW_CORE / "utils" / "utilities" / "v1.0.0"
    expected = [
        "utils.tcl", "error_utils.tcl", "config_loader.tcl",
        "directory_utils.tcl", "display_utils.tcl", "flow_init.tcl",
    ]
    for f in expected:
        if (tcl_dir / f).exists():
            ok(f) if VERBOSE else None
        else:
            fail(f"{f} — not found in utils/utilities/v1.0.0/")

    if not VERBOSE:
        found = sum(1 for f in expected if (tcl_dir / f).exists())
        ok(f"{found}/{len(expected)} core TCL utilities present")

    # Generation scripts
    gen_dir = CBFLOW_CORE / "utils" / "generation" / "v1.0.0"
    for f in ["generate_setup.tcl", "generate_config.tcl", "generate_inputs.tcl"]:
        if (gen_dir / f).exists():
            ok(f"generation/{f}") if VERBOSE else None
        else:
            fail(f"generation/{f} — not found")


# ═══════════════════════════════════════════════════════════════════════════════
# 6. Configuration Files
# ═══════════════════════════════════════════════════════════════════════════════
def check_configs():
    section("6. Configuration Files")

    config_root = CBFLOW_CORE / "config"

    # Flow config
    flow_dir = config_root / "flow" / "v1.0.0"
    flow_files = [
        ("flow_config.tcl", "Flow types, phases, stages"),
        ("tool_launch_config.tcl", "Module loads, tool shells, bsub, xterm, queue mappings"),
        ("lsf_config.tcl", "LSF queue definitions, ML analytics, cost"),
    ]
    for f, desc in flow_files:
        if (flow_dir / f).exists():
            ok(f"{f:<30s} {desc}")
        else:
            fail(f"{f:<30s} {desc}")

    # Node configs (14 flows)
    node_dir = flow_dir / "node_configs"
    expected_nodes = [
        "SYNTH_PNR", "SYNTH", "PNR", "FP", "STA", "LEC",
        "ECO", "CLP", "EMIR", "PV", "POPT", "FCFP",
    ]
    found_nodes = 0
    for flow in expected_nodes:
        if (node_dir / f"{flow}_config.tcl").exists():
            found_nodes += 1
            if VERBOSE:
                ok(f"node_configs/{flow}_config.tcl")
        else:
            fail(f"node_configs/{flow}_config.tcl — missing")
    if not VERBOSE:
        ok(f"{found_nodes}/{len(expected_nodes)} node configs present")

    # Tech configs
    tech_dir = config_root / "tech"
    if tech_dir.exists():
        tech_nodes = [d.name for d in tech_dir.iterdir() if d.is_dir()]
        for tn in tech_nodes:
            tc = tech_dir / tn / "v1.0.0" / "tech_config.tcl"
            if tc.exists():
                ok(f"tech/{tn}/v1.0.0/tech_config.tcl")
            else:
                warn(f"tech/{tn}/v1.0.0/tech_config.tcl — not found")
    else:
        fail("config/tech/ directory not found")

    # Project configs
    proj_dir = config_root / "project"
    if proj_dir.exists():
        projects = [d.name for d in proj_dir.iterdir() if d.is_dir()]
        ok(f"Projects found: {', '.join(projects)}")
    else:
        fail("config/project/ directory not found")

    # Releases
    rel_dir = CBFLOW_CORE / "releases"
    if rel_dir.exists():
        releases = sorted([d.name for d in rel_dir.iterdir()
                          if d.is_dir() and d.name.startswith("v")])
        ok(f"Releases: {', '.join(releases)}")
        # Check manifest
        for r in releases:
            mf = rel_dir / r / "manifest.json"
            if mf.exists():
                if VERBOSE:
                    ok(f"releases/{r}/manifest.json")
            else:
                warn(f"releases/{r}/manifest.json — missing")
    else:
        fail("releases/ directory not found")


# ═══════════════════════════════════════════════════════════════════════════════
# 7. Subnode Handlers (cmds/)
# ═══════════════════════════════════════════════════════════════════════════════
def check_handlers():
    section("7. Subnode Handlers (cmds/)")

    cmds_dir = CBFLOW_CORE / "cmds"
    if not cmds_dir.exists():
        fail("cmds/ directory not found")
        return

    # Count handlers per flow
    flow_handlers = {}
    total = 0
    for root, dirs, files in os.walk(cmds_dir):
        for f in files:
            if f.endswith("_subnode_handler.tcl"):
                flow = Path(root).relative_to(cmds_dir).parts[0]
                flow_handlers.setdefault(flow, 0)
                flow_handlers[flow] += 1
                total += 1

    for flow in sorted(flow_handlers):
        count = flow_handlers[flow]
        ok(f"{flow:<12s} {count:>3d} handlers")

    ok(f"Total: {total} subnode handlers")

    # ── Broken cmd_file references ──
    import re as _re
    broken_refs = []
    for root, dirs, files in os.walk(cmds_dir):
        if 'current' in root:
            continue
        for f in files:
            if not f.endswith("_subnode_handler.tcl"):
                continue
            path = Path(root) / f
            content = path.read_text()
            m = _re.search(r'set cmd_file .*\$_tool_ver/([^"]+)"', content)
            if not m:
                continue
            ref_file = m.group(1)
            if not (Path(root) / ref_file).exists():
                rel = path.relative_to(cmds_dir)
                broken_refs.append((str(rel), ref_file))

    if broken_refs:
        for h, ref in broken_refs:
            fail(f"Broken cmd_file: {h} → {ref}")
    else:
        ok(f"All handler cmd_file references valid")

    # ── Duplicate numbered handlers ──
    duplicates = []
    for root, dirs, files in os.walk(cmds_dir):
        if 'current' in root:
            continue
        for f in files:
            if not f.endswith("_subnode_handler.tcl"):
                continue
            if _re.match(r'.*\d+_subnode_handler\.tcl$', f):
                base = _re.sub(r'\d+_subnode_handler', '_subnode_handler', f)
                if (Path(root) / base).exists():
                    duplicates.append(str((Path(root) / f).relative_to(cmds_dir)))

    if duplicates:
        for d in duplicates:
            warn(f"Duplicate numbered handler: {d}")
    else:
        ok("No duplicate numbered handlers")

    # ── Stage ↔ Handler coverage ──
    node_cfg_dir = CBFLOW_CORE / "config" / "flow" / "v1.0.0" / "node_configs"
    coverage_missing = []
    if node_cfg_dir.exists():
        vendor_map = {
            'fc': 'synopsys', 'pt': 'synopsys', 'formality': 'synopsys',
            'vc_lp': 'synopsys', 'icv': 'synopsys', 'redhawk': 'synopsys',
            'power_compiler': 'synopsys', 'icc2': 'synopsys',
            'genus': 'cadence', 'innovus': 'cadence', 'tempus': 'cadence',
            'conformal': 'cadence', 'conformal_lp': 'cadence', 'voltus': 'cadence',
            'calibre': 'mentor',
        }
        for cfg_file in sorted(node_cfg_dir.iterdir()):
            if not cfg_file.name.endswith('_config.tcl') or cfg_file.name.count('_') > 1:
                continue
            flow_name = cfg_file.name.replace('_config.tcl', '')
            content = cfg_file.read_text()
            m = _re.search(r'stages\s+\{([^}]+)\}', content)
            if not m:
                continue
            stages = m.group(1).split()
            node_types = {}
            for nt_m in _re.finditer(r'node_types,(\w+)\s+"(\w+)"', content):
                node_types[nt_m.group(1)] = nt_m.group(2)
            # Find tools
            tool_cfgs = list(node_cfg_dir.glob(f'{flow_name}_*_config.tcl'))
            tools = [tc.name.replace(f'{flow_name}_', '').replace('_config.tcl', '') for tc in tool_cfgs]
            if not tools:
                st_m = _re.search(r'supported_tools\s+\{([^}]+)\}', content)
                if st_m:
                    tools = st_m.group(1).split()
            for tool in tools:
                vendor = vendor_map.get(tool, 'synopsys')
                handler_dir = cmds_dir / flow_name / vendor / tool / 'v1.0.0'
                if not handler_dir.is_dir():
                    continue
                for stage in stages:
                    nt = node_types.get(stage, stage.rstrip('0123456789'))
                    if nt == 'inputs':
                        continue
                    if not (handler_dir / f'{nt}_subnode_handler.tcl').exists():
                        coverage_missing.append(f"{flow_name}/{tool}: {nt}_subnode_handler.tcl (stage {stage})")

    if coverage_missing:
        for cm in coverage_missing:
            warn(f"Missing handler: {cm}")
    else:
        ok("All execution stages have handlers")

    # ── Launch pattern check ──
    with_launch = 0
    old_pattern = 0
    for root, dirs, files in os.walk(cmds_dir):
        for f in files:
            if f.endswith("_subnode_handler.tcl"):
                path = Path(root) / f
                content = path.read_text()
                if "Determine launch mode" in content:
                    with_launch += 1
                if "CBFLOW_USE_LSF" in content and "Determine launch mode" not in content:
                    old_pattern += 1
                    if VERBOSE:
                        warn(f"Old launch pattern: {path.relative_to(cmds_dir)}")

    ok(f"{with_launch} handlers with config-driven launch")
    if old_pattern > 0:
        warn(f"{old_pattern} handlers still using old CBFLOW_USE_LSF pattern")
    else:
        ok("No handlers with old launch pattern")


# ═══════════════════════════════════════════════════════════════════════════════
# 8. Command Files (cmds/*_fc.tcl, *_pt.tcl, etc.)
# ═══════════════════════════════════════════════════════════════════════════════
def check_command_files():
    section("8. EDA Command Files (cmds/)")

    cmds_dir = CBFLOW_CORE / "cmds"
    cmd_files = {}
    for root, dirs, files in os.walk(cmds_dir):
        for f in files:
            if f.endswith(".tcl") and not f.endswith("_subnode_handler.tcl"):
                flow = Path(root).relative_to(cmds_dir).parts[0]
                cmd_files.setdefault(flow, []).append(f)

    for flow in sorted(cmd_files):
        count = len(cmd_files[flow])
        ok(f"{flow:<12s} {count:>3d} command files")


# ═══════════════════════════════════════════════════════════════════════════════
# 9. Documentation
# ═══════════════════════════════════════════════════════════════════════════════
def check_docs():
    section("9. Documentation")

    docs_dir = CBFLOW_CORE / "docs"
    if not docs_dir.exists():
        fail("docs/ directory not found")
        return

    doc_sections = [
        "00-kickstart", "01-quick-start", "02-user-guide",
        "03-reference", "04-architecture", "05-developer", "06-examples",
    ]
    for sec in doc_sections:
        p = docs_dir / sec
        if p.exists():
            count = len(list(p.glob("*.md")))
            ok(f"{sec}/ — {count} docs")
        else:
            warn(f"{sec}/ — not found")


# ═══════════════════════════════════════════════════════════════════════════════
# 10. Stale Claude / Background-Shell Cleanup
# ═══════════════════════════════════════════════════════════════════════════════
# Detect and (with --clean) kill leaked `zsh -c .../shell-snapshots/...`
# polling loops (the `until [ -s outfile ]; sleep N; done` pattern) plus
# orphaned tclsh/python helpers that an interrupted session left behind.
# These accumulate over time and can pin file descriptors / hold cwd.
def check_stale_shells():
    section("10. Stale Background Shells")

    clean = "--clean" in sys.argv

    try:
        out = subprocess.run(
            ["ps", "-u", os.environ.get("USER", ""),
             "-o", "pid=,etime=,command="],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except Exception as e:
        warn(f"could not read ps output: {e}")
        return

    suspicious = []
    SHELL_HINTS = ("shell-snapshots", "until [ -s")
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        # Split into pid, elapsed, command
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid_s, etime, cmd = parts
        if not pid_s.isdigit():
            continue

        # Skip our own healthcheck process
        if int(pid_s) == os.getpid():
            continue

        # Match the leak patterns
        is_zsh_polling = ("/bin/zsh -c" in cmd
                          and any(h in cmd for h in SHELL_HINTS))
        is_orphan_tclsh = (cmd.lstrip().startswith("tclsh ")
                           and "CBflow_clone" in cmd)
        if not (is_zsh_polling or is_orphan_tclsh):
            continue

        # Only flag processes older than 5 minutes — younger ones may be
        # legitimately in-flight from the current session.
        if not _etime_over_5min(etime):
            continue

        suspicious.append((int(pid_s), etime, cmd))

    if not suspicious:
        ok("no stale Claude/background shells")
        return

    for pid, etime, cmd in suspicious:
        snip = cmd[:80] + ("…" if len(cmd) > 80 else "")
        if clean:
            try:
                os.kill(pid, 15)  # SIGTERM
                ok(f"killed pid={pid} (elapsed={etime}): {snip}")
            except ProcessLookupError:
                ok(f"already gone pid={pid}")
            except PermissionError:
                warn(f"no permission to kill pid={pid}: {snip}")
        else:
            warn(f"stale shell pid={pid} (elapsed={etime}): {snip}")

    if not clean:
        print(f"  → run `cbflow-healthcheck --clean` to terminate "
              f"the {len(suspicious)} stale shell(s) above.")


def _etime_over_5min(etime: str) -> bool:
    """Return True if `ps -o etime` value represents > 5 minutes.
    BSD/Linux ps formats:
        MM:SS               under 1 hour
        HH:MM:SS            under 1 day
        DD-HH:MM:SS         multi-day
    """
    if "-" in etime:                       # has days → over 5 min
        return True
    parts = etime.split(":")
    if len(parts) == 3:                    # HH:MM:SS
        return True
    if len(parts) == 2:                    # MM:SS
        try:
            return int(parts[0]) >= 5
        except ValueError:
            return False
    return False


# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════
def main():
    print()
    print("═" * 60)
    print("  CBflow Health Check")
    print(f"  Installation: {CBFLOW_CORE}")
    print("═" * 60)

    check_system()
    check_stdlib()
    check_bin_scripts()
    check_python_modules()
    check_tcl_utilities()
    check_configs()
    check_handlers()
    check_command_files()
    check_docs()
    check_stale_shells()

    # Summary
    print()
    print("═" * 60)
    print("  SUMMARY")
    print("═" * 60)
    print(f"  \033[32mPASS: {PASS}\033[0m")
    if WARN:
        print(f"  \033[33mWARN: {WARN}\033[0m")
    if FAIL:
        print(f"  \033[31mFAIL: {FAIL}\033[0m")
    else:
        print(f"  FAIL: 0")
    print()

    if FAIL == 0:
        print("  \033[32mCBflow installation is healthy.\033[0m")
    else:
        print(f"  \033[31m{FAIL} issue(s) found. Fix before running flows.\033[0m")

    print()
    return 1 if FAIL > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
