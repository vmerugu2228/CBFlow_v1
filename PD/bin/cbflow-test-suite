#!/usr/bin/env python3
"""
CBflow Comprehensive Test Suite
Tests all 12 flows across 7 categories:
  1. Workspace/run creation
  2. Makefile and handler validation
  3. Override setup/config mechanism
  4. LSF management
  5. MMMC config and scenario creation
  6. Mandatory I/O and per-node validation
  7. Log parsing and error halt mechanism

Usage: cbflow-test-suite [--flow FLOW] [--category N] [--verbose]
"""

import argparse
import os
import re
import sys
import json
import subprocess
import tempfile
import shutil
from pathlib import Path
from datetime import datetime

# ── Setup ────────────────────────────────────────────────────────────────────
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PD_DIR = os.path.dirname(SCRIPT_DIR)
sys.path.insert(0, os.path.join(PD_DIR, 'utils', 'commands'))

FLOWS = ['SYNTH', 'FP', 'PNR', 'STA', 'LEC', 'EMIR', 'PV', 'ECO', 'CLP', 'POPT', 'FCFP', 'SYNTH_PNR']

# Test results
results = {'pass': 0, 'fail': 0, 'skip': 0, 'errors': []}
verbose = False


def log_pass(test_name):
    results['pass'] += 1
    if verbose:
        print(f'  [PASS] {test_name}')


def log_fail(test_name, reason=''):
    results['fail'] += 1
    msg = f'  [FAIL] {test_name}: {reason}'
    results['errors'].append(msg)
    print(msg)


def log_skip(test_name, reason=''):
    results['skip'] += 1
    if verbose:
        print(f'  [SKIP] {test_name}: {reason}')


def log_section(title):
    print(f'\n{"=" * 70}')
    print(f'  {title}')
    print(f'{"=" * 70}')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 1: Workspace and Run Creation
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat1_workspace_creation():
    log_section('CATEGORY 1: Workspace and Run Directory Validation')

    for flow in FLOWS:
        # Check node config exists
        config_file = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'node_configs', f'{flow}_config.tcl')
        if os.path.exists(config_file):
            log_pass(f'{flow}: node config exists')
        else:
            log_fail(f'{flow}: node config missing', config_file)
            continue

        # Parse stages from config
        with open(config_file) as f:
            content = f.read()
        m = re.search(r'stages\s+\{([^}]+)\}', content)
        if m:
            stages = m.group(1).split()
            log_pass(f'{flow}: stages defined ({len(stages)}): {" ".join(stages)}')
        else:
            log_fail(f'{flow}: no stages defined in config')
            continue

        # Check each stage has dependencies
        for stage in stages:
            dep_key = f'dependencies,{stage}'
            if dep_key in content:
                log_pass(f'{flow}/{stage}: dependency defined')
            else:
                log_fail(f'{flow}/{stage}: missing dependency entry')

        # Check stage_types and node_types
        for stage in stages:
            for attr in ['stage_types', 'node_types']:
                key = f'{attr},{stage}'
                if key in content:
                    log_pass(f'{flow}/{stage}: {attr} defined')
                else:
                    log_fail(f'{flow}/{stage}: missing {attr}')

        # Check runtime/timeout
        for stage in stages:
            if f'runtime,timeout,{stage}' in content:
                log_pass(f'{flow}/{stage}: timeout defined')
            else:
                log_fail(f'{flow}/{stage}: missing runtime timeout')

    # Check flow_config.tcl
    flow_config = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'flow_config.tcl')
    if os.path.exists(flow_config):
        with open(flow_config) as f:
            fc = f.read()
        # Verify all 12 flows in flow(types)
        m = re.search(r'flow\(types\)\s+\{([^}]+)\}', fc)
        if m:
            defined_flows = m.group(1).split()
            for flow in FLOWS:
                if flow in defined_flows:
                    log_pass(f'flow_config: {flow} in flow(types)')
                else:
                    log_fail(f'flow_config: {flow} missing from flow(types)')
        log_pass('flow_config.tcl exists and parseable')
    else:
        log_fail('flow_config.tcl missing')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 2: Makefile and Handler Validation
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat2_makefiles_handlers():
    log_section('CATEGORY 2: Makefile and Handler Validation')

    for flow in FLOWS:
        # Get stages
        config_file = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'node_configs', f'{flow}_config.tcl')
        if not os.path.exists(config_file):
            log_skip(f'{flow}: no config')
            continue
        with open(config_file) as f:
            content = f.read()
        m = re.search(r'stages\s+\{([^}]+)\}', content)
        if not m:
            continue
        stages = m.group(1).split()

        # Get tool info
        tool_vendor = 'synopsys'
        tool_name = 'fc'
        vm = re.search(r'tool,vendor\s+"(\w+)"', content)
        tm = re.search(r'tool,name\s+"(\w+)"', content)
        if vm: tool_vendor = vm.group(1)
        if tm: tool_name = tm.group(1)

        cmds_dir = os.path.join(PD_DIR, 'cmds', flow, tool_vendor, tool_name, 'v1.0.0')

        if not os.path.isdir(cmds_dir):
            log_fail(f'{flow}: cmds dir missing: {cmds_dir}')
            continue

        # Check each stage has a command file or handler
        for stage in stages:
            stage_base = stage.rstrip('0123456789')  # remove trailing number

            # Look for command file
            cmd_patterns = [
                f'{stage_base}_{tool_name}.tcl',
                f'{stage_base}_fc.tcl',
                f'{stage_base}_pt.tcl',
                f'{stage_base}_icv.tcl',
                f'{stage_base}_formality.tcl',
                f'{stage_base}_vc_lp.tcl',
                f'{stage_base}_redhawk.tcl',
                f'{stage_base}_genus.tcl',
                f'{stage_base}_innovus.tcl',
                f'{stage_base}_tempus.tcl',
                f'{stage_base}_calibre.tcl',
                f'{stage_base}_conformal_lp.tcl',
                f'{stage_base}_voltus.tcl',
                f'{stage_base}_power_compiler.tcl',
            ]

            cmd_found = False
            for pat in cmd_patterns:
                if os.path.exists(os.path.join(cmds_dir, pat)):
                    cmd_found = True
                    cmd_file = os.path.join(cmds_dir, pat)

                    # Validate command file has required elements
                    with open(cmd_file) as f:
                        cmd_content = f.read()

                    # Check REPORTS_DIR
                    if 'REPORTS_DIR' in cmd_content:
                        log_pass(f'{flow}/{stage}: REPORTS_DIR defined')
                    else:
                        log_fail(f'{flow}/{stage}: REPORTS_DIR missing in {pat}')

                    # Check exit at end
                    if cmd_content.strip().endswith('exit'):
                        log_pass(f'{flow}/{stage}: exit at end')
                    else:
                        log_fail(f'{flow}/{stage}: missing exit in {pat}')

                    # Check tech_config sourcing
                    if 'tech_config' in cmd_content:
                        log_pass(f'{flow}/{stage}: tech_config sourced')
                    else:
                        log_fail(f'{flow}/{stage}: tech_config not sourced')

                    # Check user_config sourcing
                    if 'user_config' in cmd_content:
                        log_pass(f'{flow}/{stage}: user_config sourced')
                    else:
                        log_fail(f'{flow}/{stage}: user_config not sourced')

                    break

            if not cmd_found:
                # Check for handler
                handler_patterns = [
                    f'{stage_base}_subnode_handler.tcl',
                    f'{stage_base}1_subnode_handler.tcl',
                ]
                handler_found = any(os.path.exists(os.path.join(cmds_dir, hp)) for hp in handler_patterns)
                if handler_found:
                    log_pass(f'{flow}/{stage}: handler exists')
                else:
                    log_fail(f'{flow}/{stage}: no command file or handler found')

    # Check makefile_generator.py exists and is importable
    mg_path = os.path.join(PD_DIR, 'utils', 'commands', 'makefile_generator.py')
    if os.path.exists(mg_path):
        log_pass('makefile_generator.py exists')
    else:
        log_fail('makefile_generator.py missing')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 3: Override Setup and Config Mechanism
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat3_override_mechanism():
    log_section('CATEGORY 3: Override Setup and Config Mechanism')

    for flow in FLOWS:
        config_file = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'node_configs', f'{flow}_config.tcl')
        if not os.path.exists(config_file):
            continue

        with open(config_file) as f:
            content = f.read()
        m = re.search(r'tool,vendor\s+"(\w+)"', content)
        tm = re.search(r'tool,name\s+"(\w+)"', content)
        vendor = m.group(1) if m else 'synopsys'
        tool = tm.group(1) if tm else 'fc'

        cmds_dir = os.path.join(PD_DIR, 'cmds', flow, vendor, tool, 'v1.0.0')
        if not os.path.isdir(cmds_dir):
            continue

        # Check command files for override mechanism (setup.tcl, override_setup.tcl sourcing)
        for cmd_file in Path(cmds_dir).glob('*_*.tcl'):
            if 'handler' in cmd_file.name or 'subnode' in cmd_file.name:
                continue
            with open(cmd_file) as f:
                cmd_content = f.read()

            stage_base = cmd_file.stem.split('_')[0]

            # Check for setup.tcl sourcing (flow_proc hooks)
            if 'setup.tcl' in cmd_content or 'setup_file' in cmd_content:
                log_pass(f'{flow}/{cmd_file.name}: setup.tcl hook mechanism')
            else:
                log_skip(f'{flow}/{cmd_file.name}: no setup.tcl hook (may be inputs/release)')

            # Check for override_setup.tcl sourcing
            if 'override_setup' in cmd_content:
                log_pass(f'{flow}/{cmd_file.name}: override_setup mechanism')
            else:
                log_skip(f'{flow}/{cmd_file.name}: no override_setup (may be inputs/release)')

            # Check for config_file sourcing
            if 'config_file' in cmd_content or 'config.tcl' in cmd_content:
                log_pass(f'{flow}/{cmd_file.name}: config.tcl sourced')
            else:
                log_skip(f'{flow}/{cmd_file.name}: no config.tcl sourcing')

    # Check override config hierarchy: global > flow > stage > node
    flow_config = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'flow_config.tcl')
    if os.path.exists(flow_config):
        log_pass('Override hierarchy: flow_config.tcl (global level)')

    # Check project configs exist
    for proj in ['phoenix', 'ravendrive']:
        proj_dir = os.path.join(PD_DIR, 'config', 'project', proj)
        if os.path.isdir(proj_dir):
            log_pass(f'Override hierarchy: project config ({proj})')
        else:
            log_skip(f'Override hierarchy: project config ({proj}) not found')

    # Check tech configs exist
    for tech in ['gf_22nm', 'tsmc_7nm', 'tsmc_5nm']:
        tech_dir = os.path.join(PD_DIR, 'config', 'tech', tech)
        if os.path.isdir(tech_dir):
            log_pass(f'Override hierarchy: tech config ({tech})')
        else:
            log_fail(f'Override hierarchy: tech config ({tech}) missing')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 4: LSF Management
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat4_lsf_management():
    log_section('CATEGORY 4: LSF Management')

    # Check tool_launch_config.tcl
    tlc = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'tool_launch_config.tcl')
    if os.path.exists(tlc):
        with open(tlc) as f:
            content = f.read()

        # Check LSF defaults
        for key in ['bsub,queue', 'bsub,project']:
            if key in content:
                log_pass(f'tool_launch_config: {key} defined')
            else:
                log_fail(f'tool_launch_config: {key} missing')

        # Check module loads for each tool (fm = formality)
        for tool in ['fc', 'pt', 'fm', 'icv', 'redhawk', 'vc_lp', 'genus', 'innovus', 'tempus']:
            if f'module,{tool}' in content:
                log_pass(f'tool_launch_config: module load for {tool}')
            else:
                log_fail(f'tool_launch_config: missing module load for {tool}')

        # Check tool shells (fm = formality)
        for tool in ['fc', 'pt', 'fm', 'icv', 'genus', 'innovus', 'tempus']:
            if f'tool_shell,{tool}' in content:
                log_pass(f'tool_launch_config: tool_shell for {tool}')
            else:
                log_fail(f'tool_launch_config: missing tool_shell for {tool}')

        # Check queue type resources (S/M/L/XL/ultra)
        for queue in ['S', 'M', 'L', 'XL', 'ultra']:
            if f'queue_types,{queue}' in content:
                log_pass(f'tool_launch_config: queue_types {queue} resources')
            else:
                log_fail(f'tool_launch_config: queue_types {queue} missing')

        # Check flow-to-queue mappings
        for flow in FLOWS:
            flow_lower = flow.lower()
            if flow_lower in content or flow in content:
                log_pass(f'tool_launch_config: {flow} queue mapping')
            else:
                log_skip(f'tool_launch_config: {flow} queue mapping not found')
    else:
        log_fail('tool_launch_config.tcl missing')

    # Check flow_config has LSF and xterm defaults
    flow_config = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'flow_config.tcl')
    if os.path.exists(flow_config):
        with open(flow_config) as f:
            fc = f.read()
        for key in ['use_lsf', 'use_xterm']:
            if f'flow({key})' in fc:
                log_pass(f'flow_config: flow({key}) defined')
            else:
                log_fail(f'flow_config: flow({key}) missing')

    # Check lsf_cmd.py and lsf_manager_cmd.py
    for module in ['lsf_cmd.py', 'lsf_manager_cmd.py']:
        path = os.path.join(PD_DIR, 'utils', 'commands', module)
        if os.path.exists(path):
            log_pass(f'{module} exists')
        else:
            log_fail(f'{module} missing')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 5: MMMC Config and Scenario Creation
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat5_mmmc_config():
    log_section('CATEGORY 5: MMMC Config and Scenario Creation')

    # Check mmmc_config.tcl exists
    mmmc_config = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'mmmc_config.tcl')
    if os.path.exists(mmmc_config):
        with open(mmmc_config) as f:
            content = f.read()

        # Check analysis_views defined
        if 'analysis_views' in content:
            log_pass('mmmc_config: analysis_views defined')
            # Count scenarios
            scenarios = re.findall(r'analysis_views\((\w+)\)', content)
            if scenarios:
                log_pass(f'mmmc_config: {len(scenarios)} analysis views defined')
            else:
                log_skip('mmmc_config: no individual analysis_views found (may use array set)')
        else:
            log_fail('mmmc_config: analysis_views not defined')

        # Check library_sets
        if 'library_sets' in content:
            log_pass('mmmc_config: library_sets defined')
        else:
            log_fail('mmmc_config: library_sets not defined')

    else:
        log_fail('mmmc_config.tcl missing')

    # Check mmmc_manager_cmd.py
    mmmc_mgr = os.path.join(PD_DIR, 'utils', 'commands', 'mmmc_manager_cmd.py')
    if os.path.exists(mmmc_mgr):
        log_pass('mmmc_manager_cmd.py exists')
    else:
        log_fail('mmmc_manager_cmd.py missing')

    # Check MCMM creation in SYNTH_PNR init_design
    init_design = os.path.join(PD_DIR, 'cmds', 'SYNTH_PNR', 'synopsys', 'fc', 'v1.0.0', 'init_design_fc.tcl')
    if os.path.exists(init_design):
        with open(init_design) as f:
            content = f.read()
        for cmd in ['create_mode', 'create_corner', 'create_scenario']:
            if cmd in content:
                log_pass(f'init_design_fc: {cmd} present')
            else:
                log_fail(f'init_design_fc: {cmd} missing — MCMM creation incomplete')

        if 'set_scenario_status' in content:
            log_pass('init_design_fc: set_scenario_status for scenario activation')
        else:
            log_fail('init_design_fc: set_scenario_status missing')

    # Check tech configs have library_sets
    for tech in ['gf_22nm', 'tsmc_7nm', 'tsmc_5nm']:
        tech_config = os.path.join(PD_DIR, 'config', 'tech', tech, 'v1.0.0', 'tech_config.tcl')
        if os.path.exists(tech_config):
            with open(tech_config) as f:
                tc = f.read()
            if 'library_sets' in tc:
                log_pass(f'{tech}: library_sets in tech_config')
            else:
                log_fail(f'{tech}: library_sets missing in tech_config')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 6: Mandatory I/O and Per-Node Validation
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat6_mandatory_io():
    log_section('CATEGORY 6: Mandatory I/O and Per-Node Validation')

    for flow in FLOWS:
        config_file = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'node_configs', f'{flow}_config.tcl')
        if not os.path.exists(config_file):
            continue

        with open(config_file) as f:
            content = f.read()

        # Check mandatory_input_groups or critical_files
        has_mandatory = 'mandatory_input_groups' in content or 'critical_files' in content
        if has_mandatory:
            log_pass(f'{flow}: mandatory input validation defined')
        else:
            log_skip(f'{flow}: no mandatory_input_groups or critical_files')

        # Check mandatory_outputs
        if 'mandatory_outputs' in content:
            log_pass(f'{flow}: mandatory_outputs defined')
        else:
            log_skip(f'{flow}: no mandatory_outputs defined')

        # Check release_types
        if 'release_types' in content:
            log_pass(f'{flow}: release_types defined')
        else:
            log_fail(f'{flow}: release_types missing')

    # Check release_config.tcl has entries for all flows
    release_config = os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0', 'release_config.tcl')
    if os.path.exists(release_config):
        with open(release_config) as f:
            rc = f.read()
        for flow in FLOWS:
            if f'{flow},' in rc:
                log_pass(f'release_config: {flow} has release exit files')
            else:
                log_fail(f'release_config: {flow} missing from release_config')

        # Check handshake map
        if 'flow_input_handshake' in rc:
            log_pass('release_config: flow_input_handshake map defined')
        else:
            log_fail('release_config: flow_input_handshake missing')

        # Check phase criteria
        if 'phase_criteria' in rc:
            log_pass('release_config: phase_criteria defined')
        else:
            log_fail('release_config: phase_criteria missing')

        # Check milestone_flow_map
        if 'milestone_flow_map' in rc:
            log_pass('release_config: milestone_flow_map defined')
        else:
            log_fail('release_config: milestone_flow_map missing')
    else:
        log_fail('release_config.tcl missing')

    # Check release_utils.tcl
    release_utils = os.path.join(PD_DIR, 'utils', 'utilities', 'v1.0.0', 'release_utils.tcl')
    if os.path.exists(release_utils):
        with open(release_utils) as f:
            ru = f.read()
        for proc in ['::CBFlow::Release::init', '::CBFlow::Release::validate_mandatory_files',
                      '::CBFlow::InputResolve::resolve']:
            proc_name = proc.split('::')[-1]
            if f'proc {proc_name}' in ru:
                log_pass(f'release_utils: {proc} defined')
            else:
                log_fail(f'release_utils: {proc} missing')

        # No env var lookups for release data (exclude comments)
        env_refs = 0
        for line in ru.split('\n'):
            stripped = line.strip()
            if stripped.startswith('#'):
                continue
            if re.search(r'CBFLOW_RELEASE_TAG|CBFLOW_RELEASE_PHASE|CBFLOW_RELEASE_PATH', stripped):
                env_refs += 1
        if env_refs == 0:
            log_pass('release_utils: zero env var lookups for release data')
        else:
            log_fail(f'release_utils: {env_refs} env var lookups found — should use project() array')
    else:
        log_fail('release_utils.tcl missing')

    # Check inputs files have resolve_inputs
    inputs_count = 0
    resolve_count = 0
    for inputs_file in Path(os.path.join(PD_DIR, 'cmds')).rglob('inputs_*.tcl'):
        if 'handler' in inputs_file.name or 'subnode' in inputs_file.name:
            continue
        inputs_count += 1
        with open(inputs_file) as f:
            ic = f.read()
        if 'resolve_inputs' in ic:
            resolve_count += 1

    if inputs_count > 0:
        log_pass(f'Input resolution: {resolve_count}/{inputs_count} inputs files have resolve_inputs')
        if resolve_count < inputs_count:
            log_fail(f'Input resolution: {inputs_count - resolve_count} inputs files missing resolve_inputs')


# ═══════════════════════════════════════════════════════════════════════════════
# CATEGORY 7: Log Parsing and Error Halt
# ═══════════════════════════════════════════════════════════════════════════════

def test_cat7_log_parsing():
    log_section('CATEGORY 7: Log Parsing and Error Halt Mechanism')

    # Check log_viewer.py
    log_viewer = os.path.join(PD_DIR, 'utils', 'commands', 'log_viewer.py')
    if os.path.exists(log_viewer):
        with open(log_viewer) as f:
            lv = f.read()
        # Check for EDA tool error patterns
        for pattern in ['Error:', 'WARNING:', '\\*\\*ERROR', 'FATAL']:
            if pattern.replace('\\', '') in lv or pattern in lv:
                log_pass(f'log_viewer: pattern "{pattern.replace(chr(92), "")}" recognized')
            else:
                log_skip(f'log_viewer: pattern "{pattern.replace(chr(92), "")}" not found')
        log_pass('log_viewer.py exists')
    else:
        log_fail('log_viewer.py missing')

    # Check validation_cmd.py
    val_cmd = os.path.join(PD_DIR, 'utils', 'commands', 'validation_cmd.py')
    if os.path.exists(val_cmd):
        log_pass('validation_cmd.py exists')
    else:
        log_fail('validation_cmd.py missing')

    # Check that command files have flow_exec_all (which handles errors)
    exec_all_count = 0
    total_cmd_files = 0
    for cmd_file in Path(os.path.join(PD_DIR, 'cmds')).rglob('*.tcl'):
        if 'handler' in cmd_file.name or 'subnode' in cmd_file.name or 'scripts' in str(cmd_file):
            continue
        total_cmd_files += 1
        with open(cmd_file) as f:
            if 'flow_exec_all' in f.read():
                exec_all_count += 1

    log_pass(f'flow_exec_all: {exec_all_count}/{total_cmd_files} command files use flow_exec_all')

    # Check utils.tcl has error handling
    utils_tcl = os.path.join(PD_DIR, 'utils', 'utilities', 'v1.0.0', 'utils.tcl')
    if os.path.exists(utils_tcl):
        with open(utils_tcl) as f:
            ut = f.read()
        for proc in ['handle_error', 'handle_warning', 'handle_info', 'flow_proc', 'flow_exec_all']:
            if f'proc {proc}' in ut:
                log_pass(f'utils.tcl: {proc} defined')
            else:
                log_fail(f'utils.tcl: {proc} missing')
    else:
        log_fail('utils.tcl missing')

    # Check exit milestone configs
    exit_dir = os.path.join(PD_DIR, 'config', 'exit', 'v1.0.0')
    if os.path.isdir(exit_dir):
        milestones = [f.replace('_config.tcl', '') for f in os.listdir(exit_dir)
                      if f.endswith('_config.tcl') and f not in ('waiver_config.tcl', 'threshold_overrides.tcl', 'remediation_config.tcl')]
        log_pass(f'Exit milestones: {len(milestones)} defined: {", ".join(sorted(milestones))}')
    else:
        log_fail('Exit config directory missing')

    # Check checklist_cmd.py
    checklist = os.path.join(PD_DIR, 'utils', 'commands', 'checklist_cmd.py')
    if os.path.exists(checklist):
        with open(checklist) as f:
            cc = f.read()
        for cmd in ['cmd_add_check', 'cmd_remove_check', 'cmd_list_checks', 'cmd_status', 'cmd_signoff']:
            if cmd in cc:
                log_pass(f'checklist_cmd: {cmd} defined')
            else:
                log_fail(f'checklist_cmd: {cmd} missing')
    else:
        log_fail('checklist_cmd.py missing')


# ═══════════════════════════════════════════════════════════════════════════════
# BONUS: Cross-cutting checks
# ═══════════════════════════════════════════════════════════════════════════════

def test_bonus_cross_cutting():
    log_section('BONUS: Cross-Cutting Checks')

    # No $::run_dir bugs
    bug_count = 0
    for tcl_file in Path(os.path.join(PD_DIR, 'cmds')).rglob('*.tcl'):
        if 'handler' in tcl_file.name or 'subnode' in tcl_file.name:
            continue
        with open(tcl_file) as f:
            content = f.read()
        matches = re.findall(r'\$::run_dir(?!/)', content)
        # Filter out ::env refs
        real_bugs = [m for m in matches if '::env' not in content[max(0, content.find(m)-30):content.find(m)]]
        bug_count += len(real_bugs)

    if bug_count == 0:
        log_pass('No $::run_dir bugs across all command files')
    else:
        log_fail(f'{bug_count} $::run_dir references found')

    # No FCT/PHYV references in active code
    for pattern in ['FCT', 'PHYV']:
        count = 0
        for f in Path(os.path.join(PD_DIR, 'config', 'flow', 'v1.0.0')).rglob('*.tcl'):
            with open(f) as fh:
                if re.search(rf'\b{pattern}\b', fh.read()):
                    count += 1
        if count == 0:
            log_pass(f'No {pattern} references in active flow configs')
        else:
            log_fail(f'{count} files still reference {pattern}')

    # Email and AutoPPT modules
    for module in ['email_cmd.py', 'autoppt_cmd.py']:
        path = os.path.join(PD_DIR, 'utils', 'commands', module)
        if os.path.exists(path):
            log_pass(f'{module} exists')
        else:
            log_fail(f'{module} missing')

    # Completions
    for comp in ['cbflow.bash', '_cbflow']:
        path = os.path.join(PD_DIR, 'completions', comp)
        if os.path.exists(path):
            log_pass(f'Completion: {comp} exists')
        else:
            log_fail(f'Completion: {comp} missing')

    # Project configs have release,path
    for proj in ['phoenix', 'ravendrive']:
        for cfg_file in Path(os.path.join(PD_DIR, 'config', 'project', proj)).rglob('*_config.tcl'):
            with open(cfg_file) as f:
                c = f.read()
            if 'release,path' in c:
                log_pass(f'{proj}: project(release,path) defined')
                break


# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    global verbose

    parser = argparse.ArgumentParser(description='CBflow Comprehensive Test Suite')
    parser.add_argument('--flow', help='Test specific flow only')
    parser.add_argument('--category', type=int, help='Run specific category (1-7)')
    parser.add_argument('--verbose', '-v', action='store_true', help='Show all results including PASS')
    args = parser.parse_args()

    verbose = args.verbose
    if args.flow:
        global FLOWS
        FLOWS = [args.flow.upper()]

    start = datetime.now()

    print(f'\n{"#" * 70}')
    print(f'  CBflow Comprehensive Test Suite')
    print(f'  Date: {start.strftime("%Y-%m-%d %H:%M:%S")}')
    print(f'  PD Dir: {PD_DIR}')
    print(f'  Flows: {len(FLOWS)}')
    print(f'{"#" * 70}')

    categories = {
        1: ('Workspace & Run Creation', test_cat1_workspace_creation),
        2: ('Makefile & Handler Validation', test_cat2_makefiles_handlers),
        3: ('Override Setup & Config', test_cat3_override_mechanism),
        4: ('LSF Management', test_cat4_lsf_management),
        5: ('MMMC Config & Scenarios', test_cat5_mmmc_config),
        6: ('Mandatory I/O & Validation', test_cat6_mandatory_io),
        7: ('Log Parsing & Error Halt', test_cat7_log_parsing),
        8: ('Cross-Cutting Checks', test_bonus_cross_cutting),
    }

    if args.category:
        if args.category in categories:
            name, func = categories[args.category]
            func()
        else:
            print(f'ERROR: Invalid category {args.category}. Valid: 1-8')
            return 1
    else:
        for cat_num, (name, func) in sorted(categories.items()):
            func()

    # Summary
    elapsed = (datetime.now() - start).total_seconds()
    total = results['pass'] + results['fail'] + results['skip']

    print(f'\n{"#" * 70}')
    print(f'  TEST SUITE SUMMARY')
    print(f'{"#" * 70}')
    print(f'  Total Tests : {total}')
    print(f'  PASS        : {results["pass"]}')
    print(f'  FAIL        : {results["fail"]}')
    print(f'  SKIP        : {results["skip"]}')
    print(f'  Duration    : {elapsed:.1f}s')
    print(f'  Result      : {"ALL PASS" if results["fail"] == 0 else "FAILURES FOUND"}')

    if results['errors']:
        print(f'\n  FAILURES:')
        for err in results['errors']:
            print(f'  {err}')

    print(f'{"#" * 70}\n')

    return 0 if results['fail'] == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
