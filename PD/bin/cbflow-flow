#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# CBFlow - Flow Commands Router
# Description: Routes all flow subcommands to appropriate handlers
# Usage: cbflow flow <subcommand> [options]
# Note: Must be executed from CBFLOW_CORE_DIR (PD directory)
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# Ensure CBFLOW_CORE_DIR is set
if [[ -z "${CBFLOW_CORE_DIR:-}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    CBFLOW_CORE_DIR="$(dirname "$SCRIPT_DIR")"
    export CBFLOW_CORE_DIR
fi

# All commands work from any directory — CBFLOW_CORE_DIR resolved from binary location

# Source environment if available
[[ -f "$CBFLOW_CORE_DIR/config/cbflow.env" ]] && source "$CBFLOW_CORE_DIR/config/cbflow.env"

COMMANDS_DIR="$CBFLOW_CORE_DIR/utils/commands"

# Show help for flow command
show_flow_help() {
    cat << EOF
CBFlow - Flow Management (works from any directory)

Usage: cbflow flow <subcommand> [options]

Flow Information:
  cbflow flow types                              List all 11 flow types
  cbflow flow info --flow PNR                    Show PNR stages, tool, vendor
  cbflow flow stages --flow SYNTH                Show SYNTH stage sequence
  cbflow flow nodes --flow PNR                   Show PNR nodes and subnodes
  cbflow flow check                              Verify CBFlow installation

Project Management:
  cbflow flow project list                       List all projects
  cbflow flow project info --name phoenix        Show project details
  cbflow flow project create --name my_chip      Create new project

Release Management:
  cbflow flow release list                       List all releases
  cbflow flow release info --version v1.0.0      Show release details
  cbflow flow release create --type patch        Create patch release
  cbflow flow release diff --v1 v1.0.0 --v2 v1.0.1
                                                 Compare two releases
  cbflow flow release diff --v1 v1.0.0 --v2 v1.0.1 --format markdown
                                                 Compare in markdown format

Version Control:
  cbflow flow version list --dir config          List config versions
  cbflow flow version status                     Show version health

Development Workflow:
  cbflow flow dev start --component config/flow --from v1.0.0
                                                 Start dev version
  cbflow flow dev status                         Show active dev versions
  cbflow flow dev diff --component config/flow   Diff dev vs base
  cbflow flow dev promote --component config/flow
                                                 Promote dev → release-ready
  cbflow flow dev sandbox-create                 Create local sandbox
  cbflow flow dev sandbox-push                   Push sandbox to central

Configuration:
  cbflow flow config manage-flow                 Interactive flow config
  cbflow flow config manage-node                 Interactive node config
  cbflow flow config status                      Show config directory

Plugin System:
  cbflow flow plugin list                        List registered plugins
  cbflow flow plugin scaffold --name MYFLOW --vendor acme --tool mytool
                                                 Create new flow template
  cbflow flow plugin register --name MYFLOW --manifest flow_registry.json
                                                 Register a flow plugin
  cbflow flow plugin unregister --name MYFLOW    Remove a plugin

Exit Milestones & Checklists:
  cbflow flow checklist list                     List all exit milestones
  cbflow flow checklist generate --milestone FP_EXIT
                                                 Generate exit checklist
  cbflow flow checklist status --milestone FP_EXIT --run-dir <path>
                                                 Check milestone status
  cbflow flow checklist sign-off --milestone FP_EXIT --run-dir <path> --approver <name>
                                                 Record milestone sign-off
  cbflow flow checklist waiver --action list      List active waivers

QoR Reports:
  cbflow flow qor-report generate --run-dir <path>
                                                 Generate QoR summary report
  cbflow flow qor-report compare --run-dir1 <p1> --run-dir2 <p2>
                                                 Compare QoR between runs
  cbflow flow qor-report summary --project bumblebee
                                                 Aggregate QoR summary

Trending & Baselines:
  cbflow flow trending report --project bumblebee --metric wns
                                                 Show metric trend over runs
  cbflow flow trending baseline set --project bumblebee --flow PNR --milestone PRO_EXIT --metric setup_wns --value 0
                                                 Set a QoR baseline
  cbflow flow trending check --project bumblebee --run-dir <path>
                                                 Check run against baselines

MMMC Manager:
  cbflow flow mmmc-manager create --interactive   Interactive MMMC config creation
  cbflow flow mmmc-manager show                   Show current MMMC configuration
  cbflow flow mmmc-manager validate               Validate MMMC config consistency
  cbflow flow mmmc-manager generate-view-def      Generate Cadence view_definition.tcl
  cbflow flow mmmc-manager add-mode --name test   Add operating mode
  cbflow flow mmmc-manager remove-mode --name lp  Remove operating mode

Library Manager:
  cbflow flow library-manager scan --path /libs   Scan directory for .lib files
  cbflow flow library-manager create --path /libs Generate tech_config library sets
  cbflow flow library-manager check               Validate configured libraries exist
  cbflow flow library-manager list                List all configured library sets
  cbflow flow library-manager generate-mmmc --path /libs
                                                 Generate MMMC analysis views from libs

Metrics & Dashboard:
  cbflow flow metrics collect                    Collect metrics from runs
  cbflow flow metrics report                     Show metrics summary
  cbflow flow metrics report --flow PNR          Filter by flow type
  cbflow flow metrics export --format csv        Export to CSV
  cbflow flow dashboard start                    Launch web dashboard
  cbflow flow dashboard start --port 9090        Custom port

EOF
}

# Main router
main() {
    local subcmd="${1:-help}"
    shift || true

    case "$subcmd" in
        # Flow type commands - handled by flow_cmd.py
        types|info|stages|nodes|check)
            exec python3 "$COMMANDS_DIR/flow_cmd.py" "$subcmd" "$@"
            ;;

        # Project commands
        project)
            exec python3 "$COMMANDS_DIR/project_cmd.py" "$@"
            ;;

        # Version commands (version management)
        version)
            exec python3 "$COMMANDS_DIR/version_cmd.py" "$@"
            ;;

        # Release commands
        release)
            exec python3 "$COMMANDS_DIR/release_cmd.py" "$@"
            ;;

        # Development workflow
        dev)
            exec python3 "$COMMANDS_DIR/dev_cmd.py" "$@"
            ;;

        # Config commands
        config)
            exec python3 "$COMMANDS_DIR/config_cmd.py" "$@"
            ;;

        # Plugin commands
        plugin)
            exec python3 "$COMMANDS_DIR/plugin_cmd.py" "$@"
            ;;

        # Checklist commands
        checklist)
            exec python3 "$COMMANDS_DIR/checklist_cmd.py" "$@"
            ;;

        # QoR Report commands
        qor-report)
            exec python3 "$COMMANDS_DIR/qor_report_cmd.py" "$@"
            ;;

        # Trending commands
        trending)
            exec python3 "$COMMANDS_DIR/trending_cmd.py" "$@"
            ;;

        # Metrics commands
        metrics)
            exec python3 "$COMMANDS_DIR/metrics_cmd.py" "$@"
            ;;

        # Dashboard commands
        dashboard)
            exec python3 "$COMMANDS_DIR/dashboard_cmd.py" "$@"
            ;;

        # Library manager commands
        library-manager)
            exec python3 "$COMMANDS_DIR/library_manager_cmd.py" "$@"
            ;;

        # MMMC manager commands
        mmmc-manager)
            exec python3 "$COMMANDS_DIR/mmmc_manager_cmd.py" "$@"
            ;;

        lsf-manager)
            exec python3 "$COMMANDS_DIR/lsf_manager_cmd.py" "$@"
            ;;

        # Help
        --help|-h|help)
            show_flow_help
            ;;

        *)
            echo "[ERROR] Unknown subcommand: $subcmd"
            echo ""
            show_flow_help
            exit 1
            ;;
    esac
}

main "$@"
