upf_version "2.1"

set_design_top aes_cipher_top
set_scope     .

create_supply_port VDD -direction in
create_supply_port VSS -direction in

create_supply_net  VDD    -update
create_supply_net  VSS    -update
create_supply_net  VDD_SW -update

connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS

create_logic_port sleep -direction in
create_logic_net  sleep
connect_logic_net sleep -ports sleep

create_supply_set  aes_cipher_top_primary_ss \
    -function {power  VDD_SW} \
    -function {ground VSS} -update

create_supply_set  aes_cipher_top_aon_ss \
    -function {power  VDD} \
    -function {ground VSS} -update

create_power_domain PD_aes_cipher_top \
    -elements      { . } \
    -include_scope

associate_supply_set aes_cipher_top_primary_ss -handle PD_aes_cipher_top.primary
associate_supply_set aes_cipher_top_aon_ss     -handle PD_aes_cipher_top.default_isolation

create_power_switch PSW_aes_cipher_top \
    -domain             PD_aes_cipher_top \
    -input_supply_port  {vin  VDD} \
    -output_supply_port {vout VDD_SW} \
    -control_port       {sleep_in sleep} \
    -on_state           {active vin {!sleep_in}} \
    -off_state          {off {sleep_in}}

set_isolation iso_PD_aes_cipher_top_out \
    -domain              PD_aes_cipher_top \
    -applies_to          outputs \
    -clamp_value         0 \
    -isolation_signal    sleep \
    -isolation_sense     high \
    -location            parent

add_port_state VDD                       -state { NOM 1.0 1.0 1.0 }
add_port_state VSS                       -state { GND 0.0 0.0 0.0 }
add_port_state PSW_aes_cipher_top/vout   -state { ON  1.0 1.0 1.0 } \
                                         -state { OFF off }

create_pst pst_aes_cipher_top -supplies { VDD VSS PSW_aes_cipher_top/vout }
add_pst_state RUN   -pst pst_aes_cipher_top -state { NOM GND ON  }
add_pst_state SLEEP -pst pst_aes_cipher_top -state { NOM GND OFF }
