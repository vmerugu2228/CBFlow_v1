#!/usr/bin/env tclsh
# CBFlow ATPG init_atpg — testmax

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE "ATPG"
set STAGE_NAME "init_atpg"
set NODE_NAME "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

set _rel "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/release_utils.tcl"
if {[file exists $_rel]} { source $_rel }

flow_proc init_atpg_run {
    handle_info "ATPG init_atpg (testmax) running..."
    # test_mode dummy outputs are auto-generated by handler_run/launch_utils.tcl.
    # Real-tool integration goes here.

    # ── Decision-node: emit decision_outcome.txt ─────────────────────────────
    # See mirrored comment in init_atpg_tessent.tcl for semantics.
    global atpg
    set _phase "pre"
    if {[info exists atpg(pd_phase)] && $atpg(pd_phase) ne ""} {
        set _phase [string tolower $atpg(pd_phase)]
    }
    if {$_phase ni {pre post}} {
        handle_warning "atpg(pd_phase)='$_phase' is not pre|post — defaulting to 'pre'"
        set _phase "pre"
    }
    global run_dir
    set _out_dir "$run_dir/work/ATPG/init_atpg1/outputs"
    file mkdir $_out_dir
    set _fh [open "$_out_dir/decision_outcome.txt" w]
    puts -nonewline $_fh $_phase
    close $_fh
    handle_info "decision_outcome: $_phase (pd_phase=$_phase)"

    handle_info "ATPG init_atpg completed"
}
flow_proc init_atpg_flow { flow_exec init_atpg_run }
if {[info exists argv0] && $argv0 eq [info script]} { flow_exec init_atpg_flow } else { puts " ATPG init_atpg procedures loaded" }
exit
