#!/usr/bin/env tclsh
# CBflow RTL_RDC waiver_apply — synopsys spyglass
# Scaffolded command emission for the waiver_apply stage.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_RDC"
set STAGE_NAME "waiver_apply"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_waiver_apply_script {
    global rtl_rdc run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting spyglass waiver_apply script..."

    set work   "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set logdir "$run_dir/reports/rtl_rdc"
    set script "$work/waiver_apply_spyglass.tcl"

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# spyglass waiver_apply — auto-generated by CBflow"
    puts $fh "# Stage: waiver_apply / NodeType: waiver_apply"
    puts $fh "# TODO: owner team wires in real spyglass commands for waiver_apply"
    puts $fh "exit"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc waiver_apply_run {
    emit_waiver_apply_script
}

waiver_apply_run
