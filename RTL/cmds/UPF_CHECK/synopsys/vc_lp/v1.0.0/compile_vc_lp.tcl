#!/usr/bin/env tclsh
# CBflow UPF_CHECK compile — synopsys vc_lp
# Scaffolded command emission for the compile stage.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "UPF_CHECK"
set STAGE_NAME "compile"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_compile_script {
    global upf_check run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting vc_lp compile script..."

    set work   "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set logdir "$run_dir/reports/upf_check"
    set script "$work/compile_vc_lp.tcl"

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# vc_lp compile — auto-generated by CBflow"
    puts $fh "# Stage: compile / NodeType: compile"
    puts $fh "# TODO: owner team wires in real vc_lp commands for compile"
    puts $fh "exit"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc compile_run {
    emit_compile_script
}

compile_run
