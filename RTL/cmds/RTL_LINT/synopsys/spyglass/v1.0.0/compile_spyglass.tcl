#!/usr/bin/env tclsh
# CBflow RTL_LINT compile — Synopsys Spyglass
#
# Read the RTL filelist into the Spyglass project, run `current_design`
# resolution + initial elaboration via the designread flow. Emits
# work/<stage>/run/compile_spyglass.tcl which the Spyglass shell sources.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_LINT"
set STAGE_NAME "compile"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_compile_script {
    global rtl_lint run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting Spyglass compile script..."

    set top     [require_input rtl_lint top_module]
    set rtl     [require_input rtl_lint rtl]
    set work    "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set script  "$work/compile_spyglass.tcl"
    set logdir  "$run_dir/reports/rtl_lint"

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# Spyglass compile — auto-generated by CBflow"
    puts $fh "new_project -force -projectwdir $work spyglass_lint"
    # RTL input may be a bare filelist, a -f directive, or a list of
    # Verilog/SystemVerilog files. Normalize to Spyglass `read_file -type`.
    if {[string match "-f*" $rtl] || [string match "*.f" $rtl]} {
        # Filelist form
        set fl [string trimleft $rtl "-f "]
        if {[string match "-f*" $rtl]} { set fl [string range $rtl 2 end] }
        puts $fh "read_file -type sourcelist $fl"
    } else {
        foreach f $rtl {
            set ext [string tolower [file extension $f]]
            if {$ext eq ".sv" || $ext eq ".svh"} {
                puts $fh "read_file -type systemverilog $f"
            } elseif {$ext eq ".v" || $ext eq ".vh"} {
                puts $fh "read_file -type verilog $f"
            } else {
                puts $fh "read_file -type verilog $f"
            }
        }
    }
    puts $fh "set_option top $top"
    puts $fh "compile_design -force"
    puts $fh "write_report compile_summary.rpt > $logdir/compile.log"
    puts $fh "save_project"
    close $fh

    handle_info "  Wrote: $script"
    handle_info "  Log target: $logdir/compile.log"
}

flow_proc compile_run {
    emit_compile_script
}

flow_proc compile_flow { flow_exec compile_run }
if {[info exists argv0] && $argv0 eq [info script]} { flow_exec compile_flow } else { puts "RTL_LINT compile procedures loaded" }
exit
