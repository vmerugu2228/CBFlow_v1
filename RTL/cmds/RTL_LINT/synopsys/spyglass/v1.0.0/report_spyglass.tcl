#!/usr/bin/env tclsh
# CBflow RTL_LINT report — Synopsys Spyglass
#
# Final sign-off report. Reads the "unwaived" violations_final.csv,
# produces summary (counts by severity), HTML view, and a signoff.rpt
# with pass/fail verdict.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_LINT"
set STAGE_NAME "report"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_report_script {
    global rtl_lint run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting Spyglass sign-off report script..."

    set work      "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set script    "$work/report_spyglass.tcl"
    set logdir    "$run_dir/reports/rtl_lint"
    set top       [require_input rtl_lint top_module]

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# Spyglass sign-off report — auto-generated by CBflow"
    puts $fh "open_project $run_dir/work/$FLOW_TYPE/lint1/run/spyglass_lint.prj"
    puts $fh "set_option top $top"
    puts $fh "write_report moresimple > $logdir/lint_signoff.rpt"
    puts $fh "write_report html -output $logdir/violations_final.html"
    puts $fh "exit"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc report_run {
    emit_report_script
}

flow_proc report_flow { flow_exec report_run }
if {[info exists argv0] && $argv0 eq [info script]} { flow_exec report_flow } else { puts "RTL_LINT report procedures loaded" }
exit
