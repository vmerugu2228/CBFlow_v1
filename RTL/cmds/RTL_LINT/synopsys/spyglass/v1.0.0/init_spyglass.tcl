#!/usr/bin/env tclsh
# CBflow RTL_LINT init — Synopsys Spyglass
#
# Create the Spyglass project directory + initial .prj file, set the top
# module, declare the methodology, and prepare the launch directory.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_LINT"
set STAGE_NAME "init"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc init_spyglass_project {
    global rtl_lint run_dir NODE_NAME FLOW_TYPE
    handle_info "Spyglass project init..."

    set top     [require_input rtl_lint top_module]
    set work    "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set prj     "$work/${top}.prj"

    file mkdir $work

    # Emit the .prj file. Spyglass uses the .prj file as the single
    # entry point — it declares the top, methodology, and references
    # the SRC filelist.
    set fh [open $prj "w"]
    puts $fh "# Spyglass project — auto-generated by CBflow"
    puts $fh "set_option projectwdir ."
    puts $fh "set_option designread_enable_synthesis yes"
    puts $fh "set_option designread_disable_flatten  no"
    puts $fh "set_option top $top"
    puts $fh "set_option enableSV09 yes"
    if {[info exists rtl_lint(spyglass,parallel)] && [is_true $rtl_lint(spyglass,parallel)]} {
        puts $fh "set_option mthresh_filesize_kb 2048"
        puts $fh "set_option parallel 1"
        if {[info exists rtl_lint(spyglass,parallel_cores)]} {
            puts $fh "set_option machine ${rtl_lint(spyglass,parallel_cores)}"
        }
    }
    if {[info exists rtl_lint(spyglass,policy_file)] && $rtl_lint(spyglass,policy_file) ne ""} {
        puts $fh "read_file -type sgdc $rtl_lint(spyglass,policy_file)"
    }
    close $fh
    handle_info "  Wrote project: $prj"
}

flow_proc init_run {
    init_spyglass_project
}

init_run
