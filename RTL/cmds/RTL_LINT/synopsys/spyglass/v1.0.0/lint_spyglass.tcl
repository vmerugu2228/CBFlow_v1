#!/usr/bin/env tclsh
# CBflow RTL_LINT lint — Synopsys Spyglass
#
# Run the lint goal declared in rtl_lint(spyglass,goal). Writes the
# violations CSV + lint summary report under reports/rtl_lint/.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_LINT"
set STAGE_NAME "lint"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_lint_script {
    global rtl_lint run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting Spyglass lint script..."

    set top       [require_input rtl_lint top_module]
    set goal      [optional_config rtl_lint spyglass,goal "lint/lint_rtl_enhanced"]
    set work      "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set script    "$work/lint_spyglass.tcl"
    set logdir    "$run_dir/reports/rtl_lint"

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# Spyglass lint — auto-generated by CBflow"
    puts $fh "open_project $work/spyglass_lint.prj"
    puts $fh "set_option top $top"
    puts $fh "current_methodology spyglass_builtin"
    # Rule-deck. If a project-specific .sgdc file is declared, load it;
    # otherwise fall through to the methodology defaults for the goal.
    if {[info exists rtl_lint(input,rule_deck)] && $rtl_lint(input,rule_deck) ne ""} {
        puts $fh "read_file -type sgdc $rtl_lint(input,rule_deck)"
    }
    puts $fh "current_goal $goal -top $top"
    if {[info exists rtl_lint(spyglass,abort_on_fatal)] && [is_true $rtl_lint(spyglass,abort_on_fatal)]} {
        puts $fh "set_option abort_on_fatal yes"
    }
    puts $fh "run_goal"
    puts $fh "write_report moresimple > $logdir/lint_summary.rpt"
    puts $fh "write_violation -report csv -output $logdir/violations_raw.csv"
    puts $fh "save_project"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc lint_run {
    emit_lint_script
}

flow_proc lint_flow { flow_exec lint_run }
if {[info exists argv0] && $argv0 eq [info script]} { flow_exec lint_flow } else { puts "RTL_LINT lint procedures loaded" }
exit
