#!/usr/bin/env tclsh
# CBflow RTL_LINT waiver_apply — Synopsys Spyglass
#
# Apply the project waiver file. Reads the raw violations CSV written by
# lint1, filters out waivered entries, writes the "waived" CSV and the
# "remaining" CSV. Clean sign-off = zero remaining fatal + error after
# waiver.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_LINT"
set STAGE_NAME "waiver_apply"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_waiver_script {
    global rtl_lint run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting Spyglass waiver-apply script..."

    set work     "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set script   "$work/waiver_apply_spyglass.tcl"
    set logdir   "$run_dir/reports/rtl_lint"
    set top      [require_input rtl_lint top_module]

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# Spyglass waiver-apply — auto-generated by CBflow"
    puts $fh "open_project $run_dir/work/$FLOW_TYPE/lint1/run/spyglass_lint.prj"
    puts $fh "set_option top $top"
    if {[info exists rtl_lint(input,waiver_file)] && $rtl_lint(input,waiver_file) ne ""} {
        puts $fh "read_file -type awl $rtl_lint(input,waiver_file)"
    } else {
        puts $fh "# No waiver file declared — all raw violations carry forward"
    }
    puts $fh "write_report waiver_report > $logdir/waivers_applied.rpt"
    puts $fh "write_violation -report csv -status waived   -output $logdir/violations_waived.csv"
    puts $fh "write_violation -report csv -status unwaived -output $logdir/violations_final.csv"
    puts $fh "save_project"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc waiver_apply_run {
    emit_waiver_script
}

waiver_apply_run
