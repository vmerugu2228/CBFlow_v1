#!/usr/bin/env tclsh
# CBflow RTL_CDC cdc_analyze — synopsys spyglass
# Scaffolded command emission for the cdc_analyze stage.

set run_dir $::env(CBFLOW_RUN_DIR)
source "$run_dir/.run.cbflow.tcl"
source "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)/utils.tcl"

set FLOW_TYPE  "RTL_CDC"
set STAGE_NAME "cdc_analyze"
set NODE_NAME  "${STAGE_NAME}1"

source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/config.tcl"
source "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run/setup.tcl"
setup_dirs $run_dir $FLOW_TYPE $NODE_NAME

# ---------------------------------------------------------------------------

flow_proc emit_cdc_analyze_script {
    global rtl_cdc run_dir NODE_NAME FLOW_TYPE
    handle_info "Emitting spyglass cdc_analyze script..."

    set work   "$run_dir/work/$FLOW_TYPE/$NODE_NAME/run"
    set logdir "$run_dir/reports/rtl_cdc"
    set script "$work/cdc_analyze_spyglass.tcl"

    file mkdir $work $logdir

    set fh [open $script "w"]
    puts $fh "# spyglass cdc_analyze — auto-generated by CBflow"
    puts $fh "# Stage: cdc_analyze / NodeType: cdc_analyze"
    puts $fh "# TODO: owner team wires in real spyglass commands for cdc_analyze"
    puts $fh "exit"
    close $fh

    handle_info "  Wrote: $script"
}

flow_proc cdc_analyze_run {
    emit_cdc_analyze_script
}

cdc_analyze_run
