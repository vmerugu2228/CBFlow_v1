# Python
__pycache__/
*.pyc
*.pyo
.Python

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# NFS lock files
.nfs*

# Test artifacts
/tmp/
/workarea_test/*/work/
/workarea_test/*/.stamps/
/workarea_test/*/logs/
/workarea_test/*/outputs/

# IDE
.vscode/
.idea/
*.sublime-*

# VOV server state (future)
.vov/server/

# MMMC auto-backups (mmmc-manager generate creates one per regeneration —
# they pile up under config/project/<name>/v1.0.0/mmmc_config.tcl.bak_<ts>).
PD/config/project/*/*/mmmc_config.tcl.bak_*

# Release tarballs (produced by the delivery process, not source)
CBflow_v*.tar.gz
CBflow_20*.tar.gz

# AI/SmartGenie caches — regeneratable via `cbflow smartgenie ingest --all`
PD/ai/.central_knowledge_db/
PD/ai/.knowledge_db/

# Materialized test runs — regenerable via `cbflow test --keep`
workarea/*/P0_run_*/
workarea/*/LC1_run_*/
workarea/*/P*_run_*/

# Screenshots (dev-time captures, not framework)
Screenshot*.png
