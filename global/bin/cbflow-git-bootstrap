#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# cbflow-git-bootstrap — configure sparse-checkout for a discipline branch
#
# Usage:
#     cbflow-git-bootstrap pd                      # PD lead's working checkout
#     cbflow-git-bootstrap dft                     # DFT lead's working checkout
#     cbflow-git-bootstrap dv                      # DV lead's working checkout
#     cbflow-git-bootstrap all                     # integrator: full tree
#
#     cbflow-git-bootstrap dv --project bumblebee  # gated by master_projects.json
#     cbflow-git-bootstrap dft --project denali    # ERROR — denali doesn't use DFT
#
# A discipline-isolated checkout materializes only that discipline's cmds +
# configs, plus the shared global/ layer (utils, config, bin) that every
# flow needs at runtime. Other disciplines' files stay unchecked out —
# invisible to grep, invisible to IDEs, un-committable by accident.
#
# --project <name> gates the discipline against master_projects.json:
# bootstrap refuses if `name` doesn't enable that discipline. Prevents
# materializing DV/ in a clone meant for a PD-only project. Without
# --project, the bootstrap doesn't consult the registry.
#
# Run once per clone, after `git checkout <discipline-branch>`.
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

usage() {
    sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

disc=""
project=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help|help)
            usage 0
            ;;
        --project)
            if [[ $# -lt 2 ]]; then
                echo "error: --project needs a value (e.g. --project bumblebee)" >&2
                usage 2
            fi
            project="$2"
            shift 2
            ;;
        --project=*)
            project="${1#*=}"
            shift
            ;;
        -*)
            echo "error: unknown flag '$1'" >&2
            usage 2
            ;;
        *)
            if [[ -n "$disc" ]]; then
                echo "error: extra positional arg '$1' (discipline already '$disc')" >&2
                usage 2
            fi
            disc="$1"
            shift
            ;;
    esac
done

if [[ -z "$disc" ]]; then
    echo "error: expected a discipline argument (pd | dft | dv | all)" >&2
    usage 2
fi

# Must be inside a git repo.
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "error: not inside a git repository" >&2
    exit 1
fi

# Patterns per discipline. Everyone gets: global/ (shared utils + launchers +
# cross-domain config), bin/ (top-level symlinks), inputs/ + workarea/ + docs/
# (operator-facing). Only the owner's discipline dir is included.
# Cone mode takes bare directory names (no leading slash) — a slash triggers
# "specify directories rather than patterns".
case "$disc" in
    pd|PD)
        patterns=(PD global bin inputs workarea docs)
        disc_upper="PD"
        ;;
    dft|DFT)
        patterns=(DFT global bin inputs workarea docs)
        disc_upper="DFT"
        ;;
    dv|DV)
        patterns=(DV global bin inputs workarea docs)
        disc_upper="DV"
        ;;
    all|ALL|integrator)
        if [[ -n "$project" ]]; then
            echo "error: --project is meaningless with 'all' — integrator view ignores" \
                 "per-project discipline gates" >&2
            exit 2
        fi
        # Integrator view — disable sparse-checkout entirely.
        git sparse-checkout disable
        echo "cbflow-git-bootstrap: sparse-checkout disabled (full tree)"
        exit 0
        ;;
    *)
        echo "error: unknown discipline '$disc' (expected pd|dft|dv|all)" >&2
        usage 2
        ;;
esac

# When --project is given, consult master_projects.json via the Python
# helper. Refuse to materialize a discipline the project doesn't enable.
if [[ -n "$project" ]]; then
    _repo_root="$(git rev-parse --show-toplevel)"
    export PYTHONPATH="$_repo_root/global/utils/commands:$_repo_root/global/utils${PYTHONPATH:+:$PYTHONPATH}"
    python3 - "$project" "$disc_upper" <<'PY' || exit $?
import sys
project, disc = sys.argv[1], sys.argv[2]
try:
    from tcl_config_parser import (
        is_discipline_enabled_for_project, get_project_disciplines,
    )
except Exception as e:
    print(f"error: cannot load discipline gate helper ({type(e).__name__}: {e})",
          file=sys.stderr)
    sys.exit(3)
try:
    if is_discipline_enabled_for_project(project, disc):
        sys.exit(0)
    enabled = get_project_disciplines(project)
    print(f"error: project '{project}' does not enable discipline '{disc}' "
          f"(enabled: {', '.join(enabled) if enabled else '<none>'})",
          file=sys.stderr)
    sys.exit(2)
except KeyError as e:
    print(f"error: {e}", file=sys.stderr)
    sys.exit(2)
except Exception as e:
    print(f"error: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(3)
PY
    echo "cbflow-git-bootstrap: project '$project' enables discipline '$disc_upper' — proceeding"
fi

# cone mode supports leaf-dir patterns, is fast, and plays well with modern git.
git sparse-checkout init --cone
git sparse-checkout set "${patterns[@]}"

echo "cbflow-git-bootstrap: sparse-checkout configured for discipline '$disc'"
if [[ -n "$project" ]]; then
    echo "  gated by project '$project' (master_projects.json)"
fi
echo "  materialized paths:"
for p in "${patterns[@]}"; do
    echo "    $p"
done
echo ""
echo "verify what's on disk now:"
echo "  ls -la"
echo ""
echo "to switch disciplines later: cbflow-git-bootstrap <other>"
echo "to see everything again:     cbflow-git-bootstrap all"
