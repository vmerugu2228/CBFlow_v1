#!/usr/bin/env bash
# =============================================================================
# cbflow-oss — run one open-source EDA tool inside the CBflow tool container
#
# Usage:
#   cbflow-oss <tool> <cmd_file> <log_file>   run a tool on a script
#   cbflow-oss exec -- <argv...>              run an arbitrary command line
#   cbflow-oss check                          list tools + versions in the image
#   cbflow-oss gui openroad <stage.odb>       OpenROAD GUI on a saved stage database
#   cbflow-oss gui klayout <file.gds|.def>    KLayout GUI on a GDS / DEF
#   cbflow-oss interactive <tool> [script]    interactive shell (openroad, sta,
#                                             yosys, oss_tclsh) sourcing script
#                                             first; CBFLOW_OSS_GUI=1: OpenROAD GUI
#   cbflow-oss --help                         this text
#
# <tool>: yosys | openroad | sta | magic | netgen | klayout | tclsh |
#         fault | iverilog (DFT) | verilator | rtlcheck | vplan (RTL / DV): a Tcl
#         driver run by tclsh that execs the tools (fault, nl2bench, atalanta,
#         iverilog / vvp, verilator, slang, verible, opencdc, sby, python3) |
#         python3
#
# The container sees the same paths as the host: CBFLOW_ROOT, the current
# directory, CBFLOW_RUN_DIR, the PDK root and every CBFLOW_OSS_MOUNTS entry are
# bind-mounted at identical locations, and the CBflow environment
# (CBFLOW_*, FLOW_DIR, *_VERSION, PDK*) is passed through. Command files
# therefore resolve their paths exactly as they would on the host.
#
# The tool's own exit status is returned (pipefail inside the container —
# no `| tee` on the host side to mask a failure).
#
# Environment:
#   CBFLOW_OSS_IMAGE     container image   (default: pinned digest below)
#   CBFLOW_OSS_PDK_ROOT  host PDK root     (default: $HOME/eda/pdks)
#   CBFLOW_OSS_MOUNTS    extra host paths to mount, ':'-separated
#   CBFLOW_OSS_TOOLS     host dir of tools built / installed for the image:
#                        bin/ (atalanta), python/ (PeakRDL, openpyxl), uvm/current
#                        (UVM_HOME), ccache/ (CCACHE_DIR) — global/utils/oss/install_*.sh
#   CBFLOW_OSS_MAGICRC   magic rc file     (default: <pdk>/sky130A/libs.tech/magic/sky130A.magicrc)
#   CBFLOW_OSS_ENGINE    container CLI     (default: docker)
# =============================================================================
set -euo pipefail

DEFAULT_IMAGE="hpretl/iic-osic-tools@sha256:306585de35d198e70ea58950f77147c86f56c698726a19afea9f1c83009557be"
IMAGE="${CBFLOW_OSS_IMAGE:-$DEFAULT_IMAGE}"
ENGINE="${CBFLOW_OSS_ENGINE:-docker}"
PDK_ROOT_HOST="${CBFLOW_OSS_PDK_ROOT:-$HOME/eda/pdks}"

die() { echo "cbflow-oss: ERROR: $*" >&2; exit 2; }

case "${1:-}" in
    -h|--help|help)
        sed -n '/^# Usage:/,/^# =====/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
        exit 0 ;;
esac
[ $# -ge 1 ] || die "usage: cbflow-oss <tool> <cmd_file> <log_file> | exec -- <argv...> | check | gui <openroad|klayout> <file> | interactive <tool> [script]  (--help)"
command -v "$ENGINE" >/dev/null 2>&1 || die "'$ENGINE' not found — install Docker Desktop (or set CBFLOW_OSS_ENGINE)"

# Resolve CBFLOW_ROOT from this script's location (global/bin/ → root).
_self="$0"
while [ -L "$_self" ]; do
    _link="$(readlink "$_self")"
    case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
CBFLOW_ROOT="${CBFLOW_ROOT:-$(cd "$(dirname "$_self")/../.." && pwd)}"
export CBFLOW_ROOT

# ── Mounts: identical host/container paths, de-duplicated, existing only ──
MOUNTS=()
_add_mount() {
    local p="$1"
    [ -n "$p" ] || return 0
    [ -e "$p" ] || return 0
    p="$(cd "$p" 2>/dev/null && pwd -P || echo "$p")"
    local m
    for m in "${MOUNTS[@]:-}"; do
        [ -n "$m" ] || continue
        case "$p/" in "$m"/*) return 0 ;; esac      # already covered
    done
    MOUNTS+=("$p")
}
_add_mount "$CBFLOW_ROOT"
_add_mount "$PDK_ROOT_HOST"
_add_mount "${CBFLOW_RUN_DIR:-}"
_add_mount "$PWD"
IFS=':' read -r -a _extra <<< "${CBFLOW_OSS_MOUNTS:-}"
for _e in "${_extra[@]:-}"; do _add_mount "$_e"; done
_add_mount "${CBFLOW_OSS_TOOLS:-}"

# Built at run time so mounts added for the cmd/log directories are included.
build_docker_args() {
    DOCKER_ARGS=(run --rm -i -u "$(id -u):$(id -g)" -w "$(pwd -P)" -e HOME=/tmp
                 --entrypoint /bin/bash)
    # interactive sessions: an init process (PID 1) that forwards the
    # terminal's hang-up to the tool, so closing the window ends the session
    [ -n "${OSS_INIT:-}" ] && DOCKER_ARGS+=(--init)
    local m name
    for m in "${MOUNTS[@]}"; do DOCKER_ARGS+=(-v "$m:$m"); done
    while IFS='=' read -r name _; do
        case "$name" in
            CBFLOW_*|FLOW_DIR|*_VERSION|TECH_NAME|DISPLAY|USER|LOGNAME|GIT_SHA) DOCKER_ARGS+=(-e "$name") ;;
        esac
    done < <(env)
    DOCKER_ARGS+=(-e "PDK_ROOT=$PDK_ROOT_HOST" -e "PDK=${PDK:-sky130A}")
}

TOOL_PATH='export PATH=/foss/tools/bin:/foss/tools/klayout:/foss/tools/sak:$PATH; export LD_LIBRARY_PATH=/foss/tools/klayout:/foss/tools/iverilog/lib:${LD_LIBRARY_PATH:-};'
if [ -n "${CBFLOW_OSS_TOOLS:-}" ]; then
    _ot="$(printf '%q' "$CBFLOW_OSS_TOOLS")"
    # built tools (bin/), the UVM library (uvm/current) and a persistent
    # ccache for Verilator builds (ccache/). The python packages (python/)
    # are NOT put on PYTHONPATH — their antlr4 runtime differs from the one
    # the image's nl2bench needs; the RTL / DV helpers add CBFLOW_OSS_PYTHON
    # to their own sys.path.
    TOOL_PATH="$TOOL_PATH export PATH=$_ot/bin:\$PATH; export CBFLOW_OSS_PYTHON=$_ot/python; export UVM_HOME=$_ot/uvm/current; export CCACHE_DIR=$_ot/ccache;"
fi

run_in_container() {   # $1 = bash command string
    build_docker_args
    exec "$ENGINE" "${DOCKER_ARGS[@]}" "$IMAGE" -c "set -o pipefail; $TOOL_PATH $1"
}

q() { printf '%q' "$1"; }

# X11 for GUIs: the container reaches the host's X server (XQuartz on macOS)
# at host.docker.internal:0; the host must allow local clients (xhost).
gui_display() {
    local xhost_bin
    xhost_bin="$(command -v xhost || echo /opt/X11/bin/xhost)"
    if [ "$(uname)" = "Darwin" ]; then
        [ -x "$xhost_bin" ] || die "xhost not found — install XQuartz (brew install --cask xquartz)"
        "$xhost_bin" +localhost >/dev/null 2>&1 || die "cannot reach XQuartz — start it and enable Settings > Security > 'Allow connections from network clients'"
        export DISPLAY="host.docker.internal:0"
    else
        [ -n "${DISPLAY:-}" ] || die "DISPLAY is not set"
        "$xhost_bin" +local: >/dev/null 2>&1 || true
        _add_mount /tmp/.X11-unix
    fi
}

case "$1" in
    gui)
        shift
        [ $# -ge 2 ] || die "usage: cbflow-oss gui openroad <stage.odb> | gui klayout <file.gds|.def>"
        viewer="$1"; target="$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2")"
        [ -f "$target" ] || die "file not found: $target"
        _add_mount "$(dirname "$target")"
        gui_display
        case "$viewer" in
            openroad)
                gs="$(dirname "$target")/.cbflow_gui_$$.tcl"
                printf 'read_db %s\n' "$(q "$target")" > "$gs"
                run_in_container "openroad -gui -no_init $(q "$gs"); rm -f $(q "$gs")" ;;
            klayout)
                lyt="${CBFLOW_OSS_PDK_ROOT:-$HOME/eda/pdks}/${PDK:-sky130A}/libs.tech/klayout/tech/${PDK:-sky130A}.lyt"
                run_in_container "klayout -nn $(q "$lyt") $(q "$target")" ;;
            *) die "gui viewer must be openroad or klayout" ;;
        esac
        ;;
    interactive)
        # cbflow-oss interactive <tool> [tcl_script] — an interactive tool shell
        # (cbflow run interactive / the run GUI's Interactive Session) that
        # sources the script first; CBFLOW_OSS_GUI=1 opens the OpenROAD GUI.
        # No docker terminal (-t): the tools' line editors query the terminal
        # and hang over Docker Desktop's tty, and with -t docker forwards no
        # signals. The xterm's own line discipline does the editing; a small
        # read-eval loop (session file) prints the prompt and runs commands.
        shift
        [ $# -ge 1 ] || die "usage: cbflow-oss interactive <openroad|sta|yosys|oss_tclsh> [tcl_script]"
        tool="$1"; script="${2:-}"
        if [ -n "$script" ]; then
            [ -f "$script" ] || die "script not found: $script"
            sdir="$(cd "$(dirname "$script")" && pwd -P)"
        else
            sdir="$(mktemp -d "${TMPDIR:-/tmp}/cbflow-oss-session.XXXXXX")"
        fi
        _add_mount "$sdir"
        case "$tool" in
            openroad|oss_tclsh) bin=openroad; prompt="openroad> " ;;
            sta)                bin=sta;      prompt="sta> " ;;
            yosys)              bin=yosys;    prompt="yosys> " ;;
            *) die "no interactive shell for '$tool' (openroad|sta|yosys|oss_tclsh); layouts: cbflow-oss gui klayout <gds>" ;;
        esac
        # an X display for gui::show when XQuartz is reachable (macOS); the
        # session works without one (gui::show then reports no display)
        if [ "$(uname)" = Darwin ] && [ "${CBFLOW_OSS_GUI:-0}" != 1 ]; then
            _xh="$(command -v xhost || echo /opt/X11/bin/xhost)"
            if [ -x "$_xh" ] && "$_xh" +localhost >/dev/null 2>&1; then
                export DISPLAY="host.docker.internal:0"
            else
                unset DISPLAY
            fi
        fi
        if [ "$bin" = openroad ] && [ "${CBFLOW_OSS_GUI:-0}" = 1 ]; then
            gui_display
            OSS_INIT=1 run_in_container "exec openroad -gui -no_init ${script:+$(q "$script")}"
        fi
        session="$sdir/.cbflow_session.$tool.tcl"
        {
            echo "# CBflow interactive session ($tool) — generated by cbflow-oss"
            echo "fconfigure stdout -buffering line"
            [ -n "$script" ] && printf 'if {[catch {source {%s}} _e]} { puts "Error: $_e" }\n' "$script"
            [ "$bin" = yosys ] && echo 'puts "Yosys commands: yosys <command>  (e.g. yosys read_verilog x.v)"'
            cat <<'TCL'
proc ::cbflow_repl {prompt} {
    set _cmd ""
    while 1 {
        puts -nonewline [expr {$_cmd eq "" ? $prompt : "...> "}]
        flush stdout
        if {[gets stdin _line] < 0} { break }
        append _cmd $_line "\n"
        if {![info complete $_cmd]} { continue }
        if {[catch {uplevel #0 $_cmd} _res]} {
            puts "Error: $_res"
        } elseif {$_res ne ""} {
            puts $_res
        }
        set _cmd ""
    }
    puts ""
    exit
}
TCL
            printf 'cbflow_repl {%s}\n' "$prompt"
        } > "$session"
        case "$bin" in
            openroad) line="exec openroad -no_init $(q "$session")" ;;
            sta)      line="exec sta -no_init $(q "$session")" ;;
            yosys)    line="exec yosys -q -c $(q "$session")" ;;
        esac
        OSS_INIT=1 run_in_container "$line"
        ;;
    check)
        run_in_container 'for t in yosys openroad sta magic netgen klayout tclsh fault nl2bench atalanta iverilog vvp verilator slang verible-verilog-lint opencdc sby python3; do printf "%-9s %s\n" "$t" "$(command -v $t || echo MISSING)"; done; yosys -V | head -1; openroad -version | tail -1; klayout -b -v; printf "fault %s\n" "$(fault --version)"; iverilog -V 2>&1 | head -1'
        ;;
    exec)
        shift
        [ "${1:-}" = "--" ] && shift
        [ $# -ge 1 ] || die "exec needs a command line"
        cmd=""
        for a in "$@"; do cmd="$cmd $(q "$a")"; done
        run_in_container "$cmd"
        ;;
    *)
        [ $# -ge 3 ] || die "usage: cbflow-oss <tool> <cmd_file> <log_file>"
        tool="$1"; cmd_file="$2"; log_file="$3"; shift 3
        [ -f "$cmd_file" ] || die "command file not found: $cmd_file"
        mkdir -p "$(dirname "$log_file")"
        _add_mount "$(dirname "$cmd_file")"
        _add_mount "$(dirname "$log_file")"
        cf="$(q "$cmd_file")"; lf="$(q "$log_file")"
        extra=""
        for a in "$@"; do extra="$extra $(q "$a")"; done
        magicrc="${CBFLOW_OSS_MAGICRC:-$PDK_ROOT_HOST/${PDK:-sky130A}/libs.tech/magic/${PDK:-sky130A}.magicrc}"
        case "$tool" in
            yosys)    line="yosys -c $cf $extra" ;;
            openroad) line="openroad -exit -no_init -no_splash $extra $cf" ;;
            sta)      line="sta -exit -no_init -no_splash $extra $cf" ;;
            magic)    line="magic -dnull -noconsole -rcfile $(q "$magicrc") $extra $cf" ;;
            netgen)   line="netgen -batch source $cf $extra" ;;
            klayout)  line="klayout -b -r $cf $extra" ;;
            tclsh|fault|iverilog|verilator|rtlcheck|vplan) line="tclsh $cf $extra" ;;
            python3)  line="python3 $cf $extra" ;;
            *)        die "unknown tool '$tool' (yosys|openroad|sta|magic|netgen|klayout|tclsh|fault|iverilog|verilator|rtlcheck|vplan|python3)" ;;
        esac
        run_in_container "$line 2>&1 | tee $lf"
        ;;
esac
