#!/usr/bin/env python3
"""Back-compat shim. The real implementation lives in
global/utils/commands/test_cmd.py.

Preserves the original CI-facing behavior: static config-validation only
(no e2e). New callers should use `cbflow test` directly.

Passes through --flow, --category, --verbose verbatim.
"""

import os
import sys

# Launcher lives in global/bin/ (bin/ holds a symlink to it): the command
# modules are in <root>/global/utils/commands, shared packages in global/utils.
_GLOBAL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_GLOBAL, 'utils'))
sys.path.insert(0, os.path.join(_GLOBAL, 'utils', 'commands'))

from test_cmd import main as _main

if __name__ == '__main__':
    args = list(sys.argv[1:])
    if '--static' not in args and '--e2e' not in args:
        args.insert(0, '--static')
    sys.exit(_main(args))
