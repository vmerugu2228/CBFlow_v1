#!/usr/bin/env python3
"""Back-compat shim. The real implementation lives in
PD/utils/commands/test_cmd.py.

Preserves the original CI-facing behavior: static config-validation only
(no e2e). New callers should use `cbflow test` directly.

Passes through --flow, --category, --verbose verbatim.
"""

import os
import sys

# Launcher lives under global/bin/; PD is a sibling of global/.
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if os.path.basename(os.path.dirname(SCRIPT_DIR)) == 'global':
    PD_DIR = os.path.join(os.path.dirname(os.path.dirname(SCRIPT_DIR)), 'PD')
else:
    PD_DIR = os.path.dirname(SCRIPT_DIR)
sys.path.insert(0, os.path.join(PD_DIR, 'utils', 'commands'))

from test_cmd import main as _main

if __name__ == '__main__':
    args = list(sys.argv[1:])
    if '--static' not in args and '--e2e' not in args:
        args.insert(0, '--static')
    sys.exit(_main(args))
