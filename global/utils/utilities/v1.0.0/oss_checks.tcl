# ═══════════════════════════════════════════════════════════════════════════════
# Checklist library reports for the open-source flow.
#
# The exit checklists (global/config/exit/v1.0.0/checks/*.tcl) find each
# library check's data in a report file named by its `report_pattern` (searched
# under the run's work/) and read the value with its `metric_pattern`. The
# OpenROAD stages write those reports here:
#
#   oss_checks_run <stage>   — called by oss_checklist_safe (every PNR stage's
#                              report step, FP export): runs every check group
#                              proc, then writes each report file once.
#   oss_check_line <report> <line>
#                            — a group proc adds one "Key : value" line to a
#                              report (several groups may feed the same file).
#
# Check groups live in oss_checkgrp_<group>.tcl beside this file, each defining
#   proc oss_checkgrp_<group> {stage} { ... oss_check_line report_design.rpt "Nets exceeding length threshold : $n" ... }
# A group proc that fails is reported as a warning — the stage continues.
# ═══════════════════════════════════════════════════════════════════════════════

namespace eval ::oss_checks { variable lines; array set lines {} }

proc oss_check_line {report line} {
    lappend ::oss_checks::lines($report) $line
}

proc oss_checks_run {stage} {
    array unset ::oss_checks::lines
    array set ::oss_checks::lines {}
    set _dir "$::env(FLOW_DIR)/global/utils/utilities/$::env(UTILITIES_VERSION)"
    foreach _f [lsort [glob -nocomplain -directory $_dir oss_checkgrp_*.tcl]] {
        uplevel #0 [list source $_f]
    }
    set _groups [lsort [info procs ::oss_checkgrp_*]]
    foreach _p $_groups {
        if {[catch {$_p $stage} _e]} {
            handle_warning "checklist reports: [string trimleft $_p :] failed at $stage: $_e"
        }
    }
    set _n 0
    foreach _r [lsort [array names ::oss_checks::lines]] {
        set _fh [open "$::REPORTS_DIR/$_r" w]
        puts $_fh "# Checklist report ($stage) — generated by oss_checks_run (oss_checkgrp_* procs)"
        puts $_fh [join $::oss_checks::lines($_r) \n]
        close $_fh
        incr _n [llength $::oss_checks::lines($_r)]
    }
    handle_info "checklist reports: $_n line(s) in [array size ::oss_checks::lines] report(s) from [llength $_groups] group(s)"
}
